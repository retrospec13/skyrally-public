        <Item class="ModuleScript" referent="480">
          <Properties>
            <string name="Name">ClipPlayer</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source">local Math=require(script.Parent.ClipMath)
local Player={}
function Player.Apply(model,clipName,time)
local data=require(model.BakedClips);local clip=assert(data.clips[clipName],"Unknown clip");local bones={};for _,d in model:GetDescendants() do if d:IsA("Bone") then bones[d.Name]=d end end
for i,name in data.bones do local bone=assert(bones[name],"Missing bone "..name);local x,y,z,w,tx,ty,tz=Math.sample(clip,i,time,data.fps);local scale=model:GetAttribute("BossScale") or model:GetScale();bone.Transform=CFrame.new(tx*scale,ty*scale,tz*scale,x,y,z,w) end
end
function Player.Reset(model) for _,d in model:GetDescendants() do if d:IsA("Bone") then d.Transform=CFrame.identity end end end
return Player</string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
          </Properties>
        </Item>
        <Item class="StringValue" referent="481">
          <Properties>
            <string name="Name">README</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <string name="Value">Waku SkyRally Boss Pack. CC BY 4.0, attribution: Waku. Five owned rigged bosses with original mesh and all four material maps. Each BakedClips module preserves five shipped animation clips. Call require(pack.ClipPlayer).Apply(boss, clipName, seconds) each render frame; Reset(boss) restores rest pose. No automatic gameplay scripts. Online Open Use dependencies are required. Procedural wheel and prop spin are not baked clips. Gallery placement is editable.</string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
