-- shared/WorldLabelRules: distance-scaled, shortened and occlusion-debounced battle world labels.
return function(h)
	local R = h.require("src/shared/WorldLabelRules.luau")

	h.test("scale: full inside the reference distance, smaller with distance, floored", function()
		h.eq(R.scale(10, 0.6), 0.8)
		h.eq(R.scale(R.REF_DIST, 0.6), 0.8)
		h.ok(R.scale(140, 0.6) < R.scale(70, 0.6), "farther is smaller")
		h.ok(math.abs(R.scale(140, 0.6) - 0.4) < 1e-9, "half at twice the reference distance")
		h.ok(math.abs(R.scale(5000, 0.6) - 0.8 * R.MIN_K) < 1e-9, "floored at MIN_K")
		h.ok(R.scale(10, 1) <= 1, "never above 1")
		h.ok(R.scale(10, 0) >= 0.7, "base floored at 0.7")
	end)

	h.test("size: monotone with scale and never under 60 x 14", function()
		local w1, h1 = R.size(0.8)
		local w2, h2 = R.size(0.4)
		h.ok(w1 > w2 and h1 > h2, "bigger scale, bigger label")
		local w3, h3 = R.size(0.01)
		h.eq(w3, 60)
		h.eq(h3, 14)
		local wf, hf = R.size(1)
		h.eq(wf, 170)
		h.eq(hf, 28)
	end)

	h.test("shortText: nest captions shorten by distance, other captions are kept", function()
		h.eq(R.shortText("ALICE'S NEST", 30), "ALICE'S NEST")
		h.eq(R.shortText("ALICE'S NEST", 200), "ALICE")
		h.eq(R.shortText("ALEXANDRIA THE GREAT'S NEST", 30), "ALEXANDRI.'S NEST")
		h.eq(R.shortText("ALEXANDRIA THE GREAT'S NEST", 200), "ALEXAN.")
		h.eq(R.shortText("EGG", 30), "EGG")
		h.eq(R.shortText("+5", 200), "+5")
		h.eq(R.ownerName("O'S NEST"), "O")
		h.eq(R.ownerName("EGG"), nil)
		for d = 1, 400, 17 do
			h.ok(#R.shortText("ALEXANDRIA THE GREAT'S NEST", d) <= 17, "short enough at " .. d)
		end
	end)

	h.test("blocked: a hit well in front of the anchor blocks; the anchor's own ring or no hit does not", function()
		h.eq(R.blocked(nil, 80), false)
		h.eq(R.blocked(40, 80), true)
		h.eq(R.blocked(78, 80), false)
		h.eq(R.blocked(80, 80), false)
	end)

	h.test("occlusionStep: hides after two blocked rays in a row, shows at once when clear", function()
		local n, hide = R.occlusionStep(0, true)
		h.eq(n, 1)
		h.eq(hide, false)
		n, hide = R.occlusionStep(n, true)
		h.eq(hide, true)
		n, hide = R.occlusionStep(n, true)
		h.eq(n, R.OCCLUDED_TICKS)
		h.eq(hide, true)
		n, hide = R.occlusionStep(n, false)
		h.eq(n, 0)
		h.eq(hide, false)
	end)

	h.test("overlapsAny: touches or clears a keep rect with the 4 px margin", function()
		local keep = { { x = 100, y = 100, w = 50, h = 50 } }
		h.eq(R.overlapsAny(125, 125, 40, 20, keep), true)
		h.eq(R.overlapsAny(85, 125, 40, 20, keep), true) -- right edge 105 is inside the 4 px margin (96)
		h.eq(R.overlapsAny(75, 125, 40, 20, keep), false) -- right edge 95
		h.eq(R.overlapsAny(20, 125, 40, 20, keep), false)
		h.eq(R.overlapsAny(125, 300, 40, 20, keep), false)
	end)
end
