-- The portal IS the queue (economy v3 phase 3; shared/PortalQueueRules): per-arch OPEN / FILLING / RACING, join and
-- leave, the queue for the next lobby while an arch races, the start rule max(race frees the arch, own 20 s), a solo
-- lobby, two arches at once (one lobby per player), full and other-mode lobbies, and every label's copy through
-- shared/NotifySpec.
return function(h)
	local Q = h.require("src/shared/PortalQueueRules.luau")
	local RaceFlowRules = h.require("src/shared/RaceFlowRules.luau")
	local Spec = h.require("src/shared/NotifySpec.luau")
	local S = RaceFlowRules.LOBBY_SECONDS

	local function text(e: any, now: number): string
		local id, vars = Q.label(e, now)
		local row = Spec.get(id)
		assert(row, "no spec row " .. id)
		return Spec.format(row.copy, vars)
	end

	h.test("lobby length is 20 s and every label row exists in NotifySpec", function()
		h.eq(S, 20)
		for _, id in Q.ROW do
			h.ok(Spec.get(id) ~= nil, "row " .. id)
			h.eq(Spec.get(id).surface, "arch", id)
		end
		h.eq(Spec.get("portal_wait_line").surface, "banner")
		h.eq(Spec.get("portal_wait_soon").surface, "banner")
		for _, id in { "portal_joined", "portal_queued_in", "portal_left", "portal_full", "portal_other_mode", "portal_cancelled" } do
			h.eq(Spec.get(id).surface, "toast", id)
		end
	end)

	h.test("arch skins: every queue state has a known kind, a glow and no pulse but FILLING's", function()
		local Skin = h.require("src/shared/NotifySkin.luau")
		for _, st in { "open", "filling", "racing" } do
			local a = Skin.ARCH_STATES[st]
			h.ok(a ~= nil, st)
			h.ok(Skin.SKINS[a.kind] ~= nil, st .. " kind")
			h.ok(a.glow >= 0 and a.range > 0, st .. " glow")
		end
		h.ok(Skin.ARCH_STATES.filling.pulse > 0 and Skin.ARCH_STATES.open.pulse == 0 and Skin.ARCH_STATES.racing.pulse == 0)
		h.ok(Skin.ARCH_STATES.filling.glow > Skin.ARCH_STATES.open.glow, "a gathering lobby reads hottest")
		h.eq(Skin.archState("nope"), Skin.ARCH_STATES.open)
		h.eq(Skin.archState(nil), Skin.ARCH_STATES.open)
	end)

	h.test("OPEN: no lobby, no race", function()
		local q = Q.new(S, 8)
		local a = Q.arch(q, "SNOW-1")
		h.eq(Q.entry(q, a, 0), { s = "open", n = 0, c = 8 })
		h.eq(text(Q.entry(q, a, 0), 0), "RACE - drive through to start")
		h.eq(text(nil, 0), "RACE - drive through to start", "no entry published yet")
	end)

	h.test("join: the first one through opens a 20 s lobby; others join; again is a no-op", function()
		local q = Q.new(S, 8)
		h.eq({ Q.join(q, "SNOW-1", 1, "race", "portal", 100) }, { "open" })
		h.eq({ Q.join(q, "SNOW-1", 2, "race", "board", 106) }, { "join" })
		h.eq({ Q.join(q, "SNOW-1", 2, "race", "portal", 107) }, { "already" })
		local a = Q.arch(q, "SNOW-1")
		h.eq(Q.count(a), 2)
		h.eq(Q.whereIs(q, 2), "SNOW-1")
		local e = Q.entry(q, a, 106)
		h.eq(e, { s = "filling", t = 120, n = 2, c = 8, m = "race" })
		h.eq(text(e, 106), "STARTING 0:14 - 2/8")
		h.eq(text(e, 119.2), "STARTING 0:01 - 2/8", "rounds up")
		h.eq(text(e, 120.5), "STARTING 0:00 - 2/8", "never negative")
		h.eq(a.lobby.goAt, 120, "a joiner never extends the timer")
		h.eq(a.lobby.members[2].via, "board")
	end)

	h.test("due: at 0 only the joined players go; the arch is OPEN again", function()
		local q = Q.new(S, 8)
		Q.join(q, "SNOW-1", 1, "race", "portal", 100)
		Q.join(q, "SNOW-1", 2, "race", "portal", 101)
		h.eq(#Q.due(q, 119.9), 0, "not yet")
		local d = Q.due(q, 120)
		h.eq(#d, 1)
		h.eq(d[1].trackId, "SNOW-1")
		h.eq(d[1].mode, "race")
		h.eq(d[1].players, { 1, 2 })
		h.eq(Q.whereIs(q, 1), nil)
		h.eq(Q.entry(q, Q.arch(q, "SNOW-1"), 120).s, "open")
		h.eq(#Q.due(q, 121), 0, "went once")
	end)

	h.test("solo: one player gets the same 20 s lobby (bots fill)", function()
		local q = Q.new(S, 8)
		h.eq({ Q.join(q, "DINO-1", 7, "race", "portal", 0) }, { "open" })
		h.eq(#Q.due(q, 19), 0)
		local d = Q.due(q, 20)
		h.eq(d[1].players, { 7 })
	end)

	h.test("leave: the lobby keeps going without him; the last one out empties it (back to OPEN)", function()
		local q = Q.new(S, 8)
		Q.join(q, "SNOW-1", 1, "race", "portal", 0)
		Q.join(q, "SNOW-1", 2, "race", "portal", 1)
		h.eq({ Q.leave(q, 1) }, { "SNOW-1", false })
		local a = Q.arch(q, "SNOW-1")
		h.eq(Q.count(a), 1)
		h.eq(a.lobby.goAt, 20, "the opener leaving does not cancel or reset it")
		h.eq({ Q.leave(q, 2) }, { "SNOW-1", true })
		h.eq(a.lobby, nil)
		h.eq(Q.entry(q, a, 5).s, "open")
		h.eq({ Q.leave(q, 2) }, { nil, false }, "not in a lobby")
		h.eq({ Q.join(q, "SNOW-1", 2, "race", "portal", 30) }, { "open" }, "a fresh lobby, a fresh 20 s")
		h.eq(a.lobby.goAt, 50)
	end)

	h.test("RACING: a crossing joins the NEXT lobby; it waits for the race and shows the queue", function()
		local q = Q.new(S, 8)
		Q.setRace(q, "SNOW-1", "racing", 100, nil)
		local a = Q.arch(q, "SNOW-1")
		local e0 = Q.entry(q, a, 110)
		h.eq(e0.s, "racing")
		local free = 100 + Q.RACE_EST_SECONDS + Q.RESULTS_SECONDS
		h.eq(e0.t, free)
		h.eq(text(e0, free - 100), "RACING - next lobby opens in 1:40")
		h.eq(text(e0, free + 1), "RACING - next lobby opens soon", "past the estimate")
		h.eq({ Q.join(q, "SNOW-1", 5, "race", "portal", 110) }, { "queued" })
		h.eq({ Q.join(q, "SNOW-1", 6, "race", "board", 115) }, { "queued" })
		local e = Q.entry(q, a, 110)
		h.eq(e.s, "racing")
		h.eq(e.n, 2)
		h.eq(e.t, free, "max(race end, own 20 s): the race is later")
		h.eq(text(e, free - 60), "RACING - next race in 1:00 - 2/8")
		h.eq(#Q.due(q, 200), 0, "own 20 s are long done but the race still runs")
		h.ok(not Q.goingIn(a, 200, 1.5), "no plunge while the race holds the arch")
		Q.setRace(q, "SNOW-1", "results", 100, 230)
		h.eq(Q.entry(q, a, 220).t, 230, "results: the real return time")
		h.eq(#Q.due(q, 225), 0)
		Q.setRace(q, "SNOW-1", nil)
		h.ok(Q.goingIn(a, 231, 1.5))
		local d = Q.due(q, 231)
		h.eq(d[1].players, { 5, 6 }, "the race ended after the own 20 s: it goes at once")
	end)

	h.test("timer max rule: a race that frees the arch early still leaves the lobby its own 20 s", function()
		local q = Q.new(S, 8)
		Q.setRace(q, "SNOW-1", "results", 0, 105)
		Q.join(q, "SNOW-1", 9, "race", "portal", 100)
		local a = Q.arch(q, "SNOW-1")
		h.eq(Q.startAt(a, 100), 120, "max(105, 120)")
		Q.setRace(q, "SNOW-1", nil) -- the group went home at 105
		h.eq(Q.entry(q, a, 106), { s = "filling", t = 120, n = 1, c = 8, m = "race" })
		h.eq(#Q.due(q, 110), 0, "own timer not done")
		h.eq(#Q.due(q, 120), 1)
	end)

	h.test("a replay onto a fresh grid frees the arch: a due lobby joins that grid", function()
		local q = Q.new(S, 8)
		Q.setRace(q, "SNOW-1", "results", 0, 300)
		Q.join(q, "SNOW-1", 3, "race", "portal", 100)
		h.eq(#Q.due(q, 130), 0)
		Q.setRace(q, "SNOW-1", "grid", 135, nil)
		h.eq(Q.entry(q, Q.arch(q, "SNOW-1"), 130).s, "racing", "the arch still shows its race")
		h.eq(Q.entry(q, Q.arch(q, "SNOW-1"), 130).t, 120, "but the lobby counts its own timer")
		local d = Q.due(q, 130)
		h.eq(d[1].players, { 3 }, "goes to the grid (RaceInstanceRules.admit join)")
		Q.setRace(q, "SNOW-1", "closed")
		h.eq(Q.arch(q, "SNOW-1").race, nil, "closed is no race")
	end)

	h.test("two arches at once: independent lobbies; one lobby per player (moving leaves the first)", function()
		local q = Q.new(S, 8)
		h.eq({ Q.join(q, "SNOW-1", 1, "race", "portal", 0) }, { "open" })
		h.eq({ Q.join(q, "DINO-1", 2, "race", "portal", 5) }, { "open" })
		h.eq({ Q.join(q, "DINO-1", 1, "race", "board", 6) }, { "join", "SNOW-1" }, "moved from SNOW")
		h.eq(Q.arch(q, "SNOW-1").lobby, nil, "SNOW emptied")
		h.eq(Q.whereIs(q, 1), "DINO-1")
		Q.join(q, "SNOW-1", 3, "race", "portal", 8)
		local snap = Q.snapshot(q, 10)
		h.eq(snap["DINO-1"], { s = "filling", t = 25, n = 2, c = 8, m = "race" })
		h.eq(snap["SNOW-1"], { s = "filling", t = 28, n = 1, c = 8, m = "race" })
		local d1 = Q.due(q, 25)
		h.eq(#d1, 1)
		h.eq(d1[1].trackId, "DINO-1")
		h.eq(d1[1].players, { 2, 1 })
		local d2 = Q.due(q, 28)
		h.eq(d2[1].trackId, "SNOW-1")
		h.eq(d2[1].players, { 3 })
	end)

	h.test("two lobbies due on the same tick go in track order", function()
		local q = Q.new(S, 8)
		Q.join(q, "SNOW-1", 1, "race", "portal", 0)
		Q.join(q, "DINO-1", 2, "race", "portal", 0)
		local d = Q.due(q, 20)
		h.eq(#d, 2)
		h.eq(d[1].trackId, "DINO-1")
		h.eq(d[2].trackId, "SNOW-1")
	end)

	h.test("full and other-mode lobbies refuse without moving the player", function()
		local q = Q.new(S, 2)
		Q.join(q, "SNOW-1", 1, "race", "portal", 0)
		Q.join(q, "SNOW-1", 2, "race", "portal", 0)
		Q.join(q, "DINO-1", 3, "race", "portal", 0)
		h.eq({ Q.join(q, "SNOW-1", 3, "race", "portal", 1) }, { "full" })
		h.eq(Q.whereIs(q, 3), "DINO-1", "still in his own lobby")
		h.eq({ Q.join(q, "DINO-1", 4, "boss", "board", 1) }, { "mode" })
		h.eq(Q.whereIs(q, 4), nil)
		h.eq({ Q.join(q, "FOREST-1", 4, "boss", "board", 1) }, { "open" })
		h.eq(Q.arch(q, "FOREST-1").lobby.mode, "boss")
	end)

	h.test("cancel drops a whole lobby and frees its players", function()
		local q = Q.new(S, 8)
		Q.join(q, "SNOW-1", 1, "race", "portal", 0)
		Q.join(q, "SNOW-1", 2, "race", "portal", 0)
		h.eq(Q.cancel(q, "SNOW-1"), { 1, 2 })
		h.eq(Q.whereIs(q, 1), nil)
		h.eq(Q.cancel(q, "SNOW-1"), {})
		h.eq(Q.cancel(q, "NOPE"), {})
	end)

	h.test("waitLine: the joined player's HUD line", function()
		local function line(e: any, now: number): string?
			local id, vars = Q.waitLine(e, now)
			if not id then
				return nil
			end
			local row = Spec.get(id)
			return Spec.format(row.title, vars) .. " " .. Spec.format(row.copy, vars)
		end
		h.eq(line({ s = "filling", t = 14, n = 3, c = 8 }, 0), "Waiting for racers 0:14 - 3/8")
		h.eq(line({ s = "racing", t = 100, n = 1, c = 8 }, 0), "Waiting for racers 1:40 - 1/8")
		h.eq(line({ s = "racing", n = 1, c = 8 }, 0), "Waiting for racers next race soon - 1/8")
		h.eq(line({ s = "open", n = 0, c = 8 }, 0), nil)
		h.eq(line(nil, 0), nil)
	end)

	h.test("singleEntry (PER_GROUP false): the server-wide lobby shows FILLING with everyone present", function()
		local e = Q.singleEntry(50, 3, 8, "race")
		h.eq(e, { s = "filling", t = 50, n = 3, c = 8, m = "race" })
		h.eq(text(e, 36), "STARTING 0:14 - 3/8")
		h.eq(Q.singleEntry(50, 12, 8, "race").n, 8, "capped")
		h.eq(Q.singleEntry(50, 0, 8, "race").n, 1, "the opener at least")
	end)

	h.test("source guards: per group the queue talks to joined players only; single path keeps its server-wide lobby", function()
		local td = h.readFile("src/server/TrackDirector.luau")
		local a = string.find(td, "local function publishArchStates", 1, true)
		local b = string.find(td, "function TrackDirector.returnToHub", 1, true)
		h.ok(a ~= nil and b ~= nil and a < b, "queue section present")
		local section = string.sub(td, a :: number, b :: number)
		h.ok(not string.find(section, "FireAllClients", 1, true), "no server-wide message from the queue")
		h.contains(td, "elseif ok and RaceFlowRules.PER_GROUP and not soloWarp then")
		h.contains(td, "stepQueue(recs) -- phase 3")
		h.contains(td, 'remote:FireAllClients("LobbyOpen", {', "single path unchanged")
		h.contains(td, "hubReturn = returnToApron,")
		-- LEAVE is answered before the shared 1.5 s request throttle (a LEAVE right after a board JOIN is never dropped).
		local leaveAt = string.find(td, 'if action == "LeaveLobby" then', 1, true)
		local throttleAt = string.find(td, "if now - (lastRequest[player] or 0) < 1.5 then", 1, true)
		h.ok(leaveAt ~= nil and throttleAt ~= nil and leaveAt < throttleAt, "LEAVE has its own throttle")
		h.ok(RaceFlowRules.LEAVE_THROTTLE < 1.5, "shorter than the request throttle")
		local tf = h.readFile("src/client/TrackFlow.luau")
		h.contains(tf, 'fire("LeaveLobby")')
		h.contains(tf, "NotifyKit.archLabel(")
		h.contains(tf, "local ARCH_BILLBOARD = false", "one compact sign per arch: the second floating label stays off")
	end)

	h.test("clock and label guard bad input", function()
		h.eq(Q.clock(14.2), "0:15")
		h.eq(Q.clock(100), "1:40")
		h.eq(Q.clock(-3), "0:00")
		h.eq(text({ s = "weird" }, 0), "RACE - drive through to start")
		h.eq(text({ s = "filling" }, 0), "STARTING 0:00 - 0/8")
		h.eq(text({ s = "filling", t = 10, n = 2, c = 8 }, 12), "RACE - drive through to start", "a stale lobby (it went) reads OPEN")
		h.eq(text({ s = "filling", t = 10, n = 2, c = 8 }, 10.5), "STARTING 0:00 - 2/8", "the last moment still shows")
	end)
end
