-- AFK (shared/AfkRules, server/AfkService; social lane): 45 s without input marks a player AFK, any input clears it, a
-- map switch holds the clocks, the beat is rate limited, AFK players are left out of the humans a vote or lobby waits for
-- (unless they voted), long idle is a state but never a kick, and the client heartbeat stays at 5 s.
return function(h)
	local R = h.require("src/shared/AfkRules.luau")

	h.test("state: active under 45 s, afk from 45 s, long after three more minutes; bad numbers are active", function()
		h.eq(R.state(0), "active")
		h.eq(R.state(44.9), "active")
		h.eq(R.state(45), "afk")
		h.eq(R.state(45 + 179), "afk")
		h.eq(R.state(45 + 180), "long")
		h.eq(R.state(-5), "active", "clock went backwards")
		h.eq(R.state(0 / 0), "active", "NaN")
		h.ok(R.isAfk("afk") and R.isAfk("long") and not R.isAfk("active"))
		h.eq(R.IDLE_SECONDS, 45)
		h.eq(R.LONG_EXTRA_SECONDS, 180)
		h.eq(R.BEAT_SECONDS, 5)
	end)

	h.test("tracker: idle past 45 s flips to afk once; a beat clears it; the beat is rate limited", function()
		local t = R.newTracker()
		local a = {}
		t.join(a, 100)
		h.eq(t.update(130), {}, "30 s: nothing")
		local ch = t.update(145)
		h.eq(#ch, 1)
		h.eq(ch[1].from, "active")
		h.eq(ch[1].to, "afk")
		h.ok(t.isAfk(a))
		h.eq(t.update(150), {}, "already afk: no second change")
		h.ok(t.beat(a, 151), "heartbeat accepted")
		h.ok(not t.beat(a, 152), "a second beat inside MIN_BEAT_GAP is dropped")
		local back = t.update(151)
		h.eq(#back, 1)
		h.eq(back[1].to, "active")
		h.ok(not t.isAfk(a))
		h.ok(t.beat(a, 153.5), "after the gap another beat is fine")
	end)

	h.test("tracker: long idle reports afk -> long, and input brings the player straight back", function()
		local t = R.newTracker()
		local a = {}
		t.join(a, 0)
		t.update(50)
		local ch = t.update(230)
		h.eq(ch[1].to, "long")
		h.eq(t.state(a), "long")
		t.beat(a, 231)
		local back = t.update(231)
		h.eq(back[1].from, "long")
		h.eq(back[1].to, "active")
	end)

	h.test("tracker: hold() (a map switch) keeps every idle clock from running; touch() counts as activity", function()
		local t = R.newTracker()
		local a, b = {}, {}
		t.join(a, 0)
		t.join(b, 0)
		t.hold(40) -- curtain up for the whole stretch
		h.eq(t.update(80), {}, "40 s since the hold: still active")
		t.touch(b, 90)
		local ch = t.update(95)
		h.eq(#ch, 1, "only a goes AFK")
		h.ok(t.isAfk(a) and not t.isAfk(b))
		t.leave(a)
		h.eq(t.state(a), "active", "an unknown player is active")
		h.ok(not t.beat(a, 100), "a heartbeat from a stranger is refused")
	end)

	h.test("effectiveHumans: AFK players do not count unless they have voted", function()
		local a, b, c = { afk = false }, { afk = true }, { afk = true }
		local votes = { [c] = "hub" }
		local n = R.effectiveHumans({ a, b, c }, function(p)
			return p.afk
		end, function(p)
			return votes[p] ~= nil
		end)
		h.eq(n, 2, "a active + c afk-but-voted; b is left out")
		local solo = R.effectiveHumans({ a, b }, function(p)
			return p.afk
		end, function()
			return false
		end)
		h.eq(solo, 1)
		local RaceFlowRules = h.require("src/shared/RaceFlowRules.luau")
		h.ok(not RaceFlowRules.isGroup(solo), "one active human + one AFK: the solo flow (no lobby, no vote)")
		h.eq(RaceFlowRules.decide(1, 0, solo, false), "again", "the active human's vote acts at once")
	end)

	h.test("AfkService: marks the attribute at 45 s, clears it on a beat, tells TrackDirector, never kicks", function()
		local sched = h.newScheduler(1000)
		local Afk = h.require("src/server/AfkService.luau")
		Afk.clock = sched.clock
		local p = h.fakePlayer(11, "Idle")
		local q = h.fakePlayer(12, "Busy")
		table.insert(h.stubs.Players.list, p)
		table.insert(h.stubs.Players.list, q)
		Afk.track(p)
		Afk.track(q)
		local changes = {}
		Afk.onChange = function(player, afk)
			table.insert(changes, player.Name .. ":" .. tostring(afk))
		end
		sched.advance(30)
		Afk.onBeat(q)
		Afk.evaluate()
		h.ok(not Afk.isAfk(p), "30 s idle: active")
		sched.advance(20) -- 50 s idle for p, 20 s for q
		Afk.evaluate()
		h.ok(Afk.isAfk(p) and not Afk.isAfk(q))
		h.eq(p:GetAttribute("Afk"), true)
		h.eq(q:GetAttribute("Afk"), nil)
		h.ok(p.Parent ~= nil, "AFK never removes the player")
		h.eq(Afk.state(p), "afk")
		sched.advance(200)
		Afk.evaluate()
		h.eq(Afk.state(p), "long")
		h.eq(p:GetAttribute("AfkLong"), true)
		h.ok(p.Parent ~= nil, "three more idle minutes: still not kicked")
		Afk.onBeat(p)
		h.ok(not Afk.isAfk(p), "a beat clears AFK at once, without waiting for the next tick")
		h.eq(p:GetAttribute("Afk"), nil)
		h.eq(p:GetAttribute("AfkLong"), nil)
		Afk.untrack(p)
		Afk.untrack(q)
		h.ok(not Afk.isAfk(p), "untracked players are never AFK")
		h.eq(changes[1], "Idle:true")
		h.eq(changes[#changes], "Idle:false")
		h.stubs.Players.list = {}
	end)

	h.test("AfkService: a map switch holds the clocks (workspace.TrackSwitching)", function()
		local sched = h.newScheduler(5000)
		local Afk = h.require("src/server/AfkService.luau")
		Afk.clock = sched.clock
		local p = h.fakePlayer(21, "Loading")
		table.insert(h.stubs.Players.list, p)
		Afk.track(p)
		h.stubs.workspace:SetAttribute("TrackSwitching", true)
		sched.advance(40)
		Afk.evaluate()
		sched.advance(40)
		Afk.evaluate()
		h.ok(not Afk.isAfk(p), "80 s behind the curtain is not idleness")
		h.stubs.workspace:SetAttribute("TrackSwitching", nil)
		sched.advance(44)
		Afk.evaluate()
		h.ok(not Afk.isAfk(p), "44 s after the curtain: active")
		sched.advance(2)
		Afk.evaluate()
		h.ok(Afk.isAfk(p), "46 s after the curtain: AFK")
		Afk.untrack(p)
		h.stubs.Players.list = {}
	end)

	h.test("static: the client only sends heartbeats at the rules' pace and never says it is AFK", function()
		local src = h.readFile("src/client/AfkBeat.luau")
		h.contains(src, "AfkRules.BEAT_SECONDS")
		h.contains(src, "r:FireServer()", "the beat carries no payload")
		h.ok(not string.find(src, "FireServer%([^)]"), "no argument can claim a state")
		h.contains(src, "GetKeysPressed", "a held throttle key counts as input")
		h.contains(src, "AutoPilot", "QA autopilot never looks AFK")
	end)

	h.test("static: TrackDirector uses the AFK-aware human count for votes, the lobby and the solo check", function()
		local src = h.readFile("src/server/TrackDirector.luau")
		h.ok(not string.find(src, "isGroup(#Players:GetPlayers())", 1, true), "no raw head-count left in the group rule")
		h.contains(src, "humanCount()")
		h.contains(src, "function TrackDirector.afkChanged")
		local boot = h.readFile("src/server/init.server.luau")
		h.contains(boot, "TrackDirector.afkCheck = AfkService.isAfk")
		h.contains(boot, "TrackDirector.afkTouch = AfkService.touch")
	end)
end
