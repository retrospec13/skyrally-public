--!nocheck
--[[
	30MAPS overview camera (generated by tools/build_plan.py --overview-cam).
	QA aid: holds the camera on an orbit view of the plan's camera focus so a
	screenshot shows the whole map. Press V to toggle back to the normal
	player camera.
]]
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local FOCUS = Vector3.new(@@FOCUS@@)
local RADIUS = @@RADIUS@@
local DIR = Vector3.new(@@DIR@@).Unit

local on = true
UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == Enum.KeyCode.V and not processed then
		on = not on
		if not on then
			workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
		end
		print("[30MAPS] overview camera", on and "on" or "off")
	end
end)

RunService:BindToRenderStep("30MapsOverview", Enum.RenderPriority.Camera.Value + 1, function()
	if not on then
		return
	end
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 60
	cam.CFrame = CFrame.lookAt(FOCUS + DIR * RADIUS * 1.25, FOCUS)
end)
