------------------------------------------------------------------ helpers
local function color(hex, fallback)
	if type(hex) ~= "string" then
		return fallback or Color3.new(1, 1, 1)
	end
	local ok, c = pcall(Color3.fromHex, hex)
	if ok then
		return c
	end
	return fallback or Color3.new(1, 1, 1)
end

local materialCache = {}
local function material(name, fallback)
	if type(name) ~= "string" then
		return fallback
	end
	local cached = materialCache[name]
	if cached == nil then
		local ok, item = pcall(function()
			return Enum.Material[name]
		end)
		cached = if ok and item then item else false
		materialCache[name] = cached
	end
	return if cached then cached else fallback
end

-- plan rotation: nil/0, a yaw in degrees, or {rx, ry, rz} degrees (YXZ order)
local function rotation(r)
	if type(r) == "number" then
		if r == 0 then
			return CFrame.identity
		end
		return CFrame.fromEulerAnglesYXZ(0, math.rad(r), 0)
	elseif type(r) == "table" then
		return CFrame.fromEulerAnglesYXZ(math.rad(r[1] or 0), math.rad(r[2] or 0), math.rad(r[3] or 0))
	end
	return CFrame.identity
end

local function v3(t)
	return Vector3.new(t[1], t[2], t[3])
end

