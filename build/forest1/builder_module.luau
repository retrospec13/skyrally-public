-- SKYRALLY PATCH: root is Workspace.Maps.<name>; only this map's child is replaced, other maps and any
-- stock root stay untouched
local mapFolder = replaceFolder(ensureFolder(workspace, "Maps"), DATA.name)
-- SKYRALLY PATCH (terrain bake): what tools/bake_terrain.py copies, and whether this build pasted a bake
mapFolder:SetAttribute("TerrainHash", TERRAIN_HASH)
mapFolder:SetAttribute("TerrainBaked", terrainBaked)
if terrainCells then
	local a, b = terrainCells[1], terrainCells[2]
	mapFolder:SetAttribute("TerrainCellMin", Vector3.new(a.X, a.Y, a.Z))
	mapFolder:SetAttribute("TerrainCellMax", Vector3.new(b.X, b.Y, b.Z))
end

local groupFolders = {}
local function groupFolder(g)
	local f = groupFolders[g]
	if f then
		return f
	end
	local path = DATA.groups[g] or "Ungrouped"
	local parent = mapFolder
	for seg in string.gmatch(path, "[^/]+") do
		local child = parent:FindFirstChild(seg)
		if child == nil then
			child = Instance.new("Folder")
			child.Name = seg
			child.Parent = parent
		end
		parent = child
	end
	groupFolders[g] = parent
	return parent
end

local N = #DATA.instances
local parts = 0
-- SKYRALLY PATCH (boot time, V1 D1): yield after YIELD_SLICE seconds of work, not after every 50 instances. Each
-- yield costs one whole server frame, and while a map loads in Studio (server and client in one process, the client
-- receiving and drawing the parts just added) such a frame ran about 0.1-0.15 s: SPACE-4's 3268 instances made 65
-- yields, most of its 9-10 s build. Same parts, same order, same places: only fewer yields.
local YIELD_SLICE = 0.1
local sliceT0 = os.clock()
for i, inst in DATA.instances do
	-- inst = { prefabIndex, group, x, y, z, r, s }
	local ok, err = pcall(function()
		local model = template(inst[1]):Clone()
		scaleModel(model, inst[7] or 1)
		model:PivotTo(CFrame.new(inst[3], inst[4], inst[5]) * rotation(inst[6]))
		model.Parent = groupFolder(inst[2])
		parts += #model:GetChildren()
	end)
	if not ok then
		buildErrors += 1 -- SKYRALLY PATCH
		warn(TAG, "instance", i, "failed:", err)
	end
	if os.clock() - sliceT0 >= YIELD_SLICE then -- SKYRALLY PATCH (boot time, V1 D1)
		task.wait()
		sliceT0 = os.clock()
	end
	if i % 250 == 0 or i == N then
		log(("built %d/%d instances (%d parts, %.1fs)"):format(i, N, parts, os.clock() - T0))
	end
end

------------------------------------------------------------------ markers + labels
local markerFolder = Instance.new("Folder")
markerFolder.Name = "Markers"
markerFolder.Parent = mapFolder
local MARKER_COLORS = {
	Checkpoint = Color3.fromRGB(255, 200, 60),
	Objective = Color3.fromRGB(255, 90, 90),
	Teleport = Color3.fromRGB(120, 140, 255),
}
for _, m in DATA.markers do
	local c = MARKER_COLORS[m.kind]
	if c then
		local p = Instance.new("Part")
		p.Name = m.kind .. "_" .. (m.name or m.index or "")
		p.Anchored = true
		p.CanCollide = false
		p.Material = Enum.Material.Neon
		p.Color = c
		p.Transparency = 0.35
		p.Size = Vector3.new(8, 0.4, 8)
		p.CFrame = CFrame.new(v3(m.p))
		p:SetAttribute("MarkerKind", m.kind)
		if m.index then
			p:SetAttribute("Index", m.index)
		end
		p.Parent = markerFolder
	end
end
for _, lab in DATA.labels do
	local anchor = Instance.new("Part")
	anchor.Name = "Label_" .. lab.text
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.CFrame = CFrame.new(v3(lab.p))
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(240, 40)
	bb.MaxDistance = 900
	bb.LightInfluence = 0
	local tl = Instance.new("TextLabel")
	tl.BackgroundTransparency = 1
	tl.Size = UDim2.fromScale(1, 1)
	tl.Font = Enum.Font.GothamBold
	tl.TextScaled = true
	tl.TextColor3 = Color3.new(1, 1, 1)
	tl.TextStrokeTransparency = 0.3
	tl.Text = lab.text
	tl.Parent = bb
	bb.Parent = anchor
	anchor.Parent = markerFolder
end

-- SKYRALLY PATCH: root attributes first so a waiter woken by READY_ATTR sees the error count;
-- the unscoped Workspace MapBuilt is dropped (with several maps it would mean "some map finished")
mapFolder:SetAttribute("MapBuildErrors", buildErrors)
mapFolder:SetAttribute("MapBuilt", true)
workspace:SetAttribute(READY_ATTR, true)
if buildErrors > 0 then
	warn(TAG, ("%s finished with %d build error(s); see the warnings above"):format(DATA.name, buildErrors))
end
log(("DONE %s: %d/%d instances, %d parts, %d markers, %d labels in %.1fs"):format(
	DATA.name, N, N, parts, #DATA.markers, #DATA.labels, os.clock() - T0))

return true
