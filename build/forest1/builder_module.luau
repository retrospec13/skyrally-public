-- terrain loop below writes, and is pasted in one call instead (tools/bake_terrain.py makes it from this builder).
local TERRAIN_HASH = "32904ecfec3aa450"
local terrainCells = nil -- SKYRALLY PATCH (terrain bake): { min, max } voxel cells the terrain step covers
