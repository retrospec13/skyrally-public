-- SKYRALLY PATCH: the game owns its SpawnLocations; Spawn markers never move or resize one
local spawnMarkers = 0
for _, m in DATA.markers do
	if m.kind == "Spawn" then
		spawnMarkers += 1
	end
end
if spawnMarkers > 0 then
	log(("%d Spawn marker(s) ignored (SkyRally owns spawns)"):format(spawnMarkers))
end

------------------------------------------------------------------ lighting
local function applyLighting(L)
	if type(L) ~= "table" then
		return
	end
	pcall(function()
		Lighting.ClockTime = L.clockTime or 14
		Lighting.Brightness = L.brightness or 2
		Lighting.Ambient = color(L.ambient, Lighting.Ambient)
		Lighting.OutdoorAmbient = color(L.outdoorAmbient, Lighting.OutdoorAmbient)
		Lighting.ColorShift_Top = color(L.colorShiftTop, Lighting.ColorShift_Top)
		Lighting.ColorShift_Bottom = color(L.colorShiftBottom, Lighting.ColorShift_Bottom)
		Lighting.EnvironmentDiffuseScale = L.envDiffuse or 1
		Lighting.EnvironmentSpecularScale = L.envSpecular or 1
		Lighting.ExposureCompensation = L.exposure or 0
		Lighting.ShadowSoftness = L.shadowSoftness or 0.2
		Lighting.GlobalShadows = true
	end)
	for _, c in Lighting:GetChildren() do
		if c:IsA("Atmosphere") or c:IsA("PostEffect") then
			c:Destroy()
		end
	end
	local a = L.atmosphere
	if type(a) == "table" then
		local atm = Instance.new("Atmosphere")
		atm.Density = a.density or 0.3
		atm.Offset = a.offset or 0.25
		atm.Color = color(a.color, atm.Color)
		atm.Decay = color(a.decay, atm.Decay)
		atm.Glare = a.glare or 0
		atm.Haze = a.haze or 0
		atm.Parent = Lighting
	end
	local b = L.bloom
	if type(b) == "table" then
		local e = Instance.new("BloomEffect")
		e.Intensity = b.intensity or 0.4
		e.Size = b.size or 24
		e.Threshold = b.threshold or 2
		e.Parent = Lighting
	end
	local c = L.correction
	if type(c) == "table" then
		local e = Instance.new("ColorCorrectionEffect")
		e.Brightness = c.brightness or 0
		e.Contrast = c.contrast or 0
		e.Saturation = c.saturation or 0
		e.TintColor = color(c.tint, Color3.new(1, 1, 1))
		e.Parent = Lighting
	end
	local r = L.rays
	if type(r) == "table" then
		local e = Instance.new("SunRaysEffect")
		e.Intensity = r.intensity or 0.05
		e.Spread = r.spread or 0.5
		e.Parent = Lighting
	end
	local cl = L.clouds
	if type(cl) == "table" then
		pcall(function()
			local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
			clouds.Cover = cl.cover or 0.5
			clouds.Density = cl.density or 0.5
			clouds.Color = color(cl.color, Color3.new(1, 1, 1))
			clouds.Parent = workspace.Terrain
		end)
	end
	log("lighting applied", L.lookLabel or L.look or "")
end
-- SKYRALLY PATCH: SkyRally owns Lighting through LightingProfiles; a plan lighting block is never applied
-- (dropping it also keeps lights.on and lighting.water out of PointLights and Terrain water)
if DATA.lighting ~= nil then
	log("plan lighting block ignored (SkyRally LightingProfiles owns Lighting)")
	DATA.lighting = nil
end

------------------------------------------------------------------ terrain
local RES = 4
local CHUNK = 32 -- voxel columns per chunk side (128 studs)
local SURFACE_DEPTH = 8

local function clamp(v, lo, hi)
	return if v < lo then lo elseif v > hi then hi else v
end
local function floor4(v)
	return math.floor(v / RES) * RES
end
local function ceil4(v)
	return math.ceil(v / RES) * RES
end
-- fraction of the voxel [y0, y0 + RES] inside [lo, hi]
local function overlap(lo, hi, y0)
	local a = if lo > y0 then lo else y0
	local b = if hi < y0 + RES then hi else y0 + RES
	local d = b - a
	if d <= 0 then
		return 0
	elseif d >= RES then
		return 1
	end
	return d / RES
end

local function keyIndex(t, key, fallback)
	for i, e in t.palette or {} do
		if e.key == key then
			return i
		end
	end
	return fallback
end

local function buildTerrain(t)
	if type(t) ~= "table" or type(t.heights) ~= "table" then
		log("no terrain in plan")
		return
	end
	local terrain = workspace.Terrain
	local cell, nx, nz, x0, z0 = t.cell or 4, t.nx, t.nz, t.x0, t.z0
	local x1, z1 = x0 + (nx - 1) * cell, z0 + (nz - 1) * cell
	local H, M, C = t.heights, t.materials or {}, t.ceilings
	local roof = t.roof
	local water = t.water
	local level = if water and not water.lava then water.level else nil
	local floorY = t.floor or -48

	-- palette index -> Enum.Material (unknown names fall back to Grass)
	local palMat = {}
	for i, p in t.palette or {} do
		palMat[i] = material(p.material, Enum.Material.Grass)
	end
	local defaultMat = palMat[1] or Enum.Material.Grass
	local deepIdx = keyIndex(t, "rock", 1)
	local ceilIdx = t.ceilingMaterial or deepIdx
	local pathIdx, plazaIdx = keyIndex(t, "path", -1), keyIndex(t, "plaza", -1)

	-- node grid is row-major: node (ix, iz) at index iz * nx + ix + 1, world (x0 + ix*cell, z0 + iz*cell)
	local function corners(x, z)
		local fx = (clamp(x, x0, x1) - x0) / cell
		local fz = (clamp(z, z0, z1) - z0) / cell
		local ix = math.max(math.min(math.floor(fx), nx - 2), 0)
		local iz = math.max(math.min(math.floor(fz), nz - 2), 0)
		local k = iz * nx + ix + 1
		return k, k + 1, k + nx, k + nx + 1, fx - ix, fz - iz
	end
	local function lerp4(a, b, c, d, tx, tz)
		local u = a + (b - a) * tx
		local v = c + (d - c) * tx
		return u + (v - u) * tz
	end
	local function height(x, z)
		local a, b, c, d, tx, tz = corners(x, z)
		return lerp4(H[a] or 0, H[b] or 0, H[c] or 0, H[d] or 0, tx, tz)
	end
	local function mat(x, z)
		local a, b, c, d = corners(x, z)
		local ma, mb, mc, md = M[a] or 1, M[b] or 1, M[c] or 1, M[d] or 1
		local best, bestN = ma, 0
		for _, m in { ma, mb, mc, md } do
			local n = (if ma == m then 1 else 0) + (if mb == m then 1 else 0) + (if mc == m then 1 else 0) + (if md == m then 1 else 0)
			if n > bestN or (n == bestN and (m == pathIdx or m == plazaIdx)) then
				best, bestN = m, n
			end
		end
		return best
	end
	local ceiling = nil
	if type(C) == "table" and type(roof) == "number" then
		ceiling = function(x, z)
			local a, b, c, d, tx, tz = corners(x, z)
			return lerp4(C[a] or roof, C[b] or roof, C[c] or roof, C[d] or roof, tx, tz)
		end
	end

	-- one column: returns at(y0) -> solid occupancy, palette index, liquid occupancy; plus top Y
	local function column(h, m, ceil)
		local gLo, gHi = floorY, h
		local cLo, cHi = nil, nil
		if ceil and roof then
			if ceil <= h then
				gHi = math.max(h, roof) -- ceiling meets ground: solid wall up to the roof
			elseif ceil < roof - 0.05 then
				cLo, cHi = ceil, roof -- overhang (arch / cave roof)
			end
		end
		local wLo, wHi = nil, nil
		if level and h < level then
			wLo, wHi = h, level
			if cLo and cLo < wHi then
				wHi = cLo
			end
			if wHi <= wLo then
				wLo = nil
			end
		end
		local surfaceFloor = h - SURFACE_DEPTH
		local top = gHi
		if cHi then
			top = math.max(top, cHi)
		end
		if wLo then
			top = math.max(top, wHi)
		end
		local function at(y0)
			local g = overlap(gLo, gHi, y0)
			local c = if cLo then overlap(cLo, cHi, y0) else 0
			local l = if wLo then overlap(wLo, wHi, y0) else 0
			local solid = g + c
			local mi = m
			if g > 0 then
				local mid = y0 + RES * 0.5
				if mid < surfaceFloor and mid < h then
					mi = deepIdx -- rock below the top 8 studs, so cliffs show rock
				end
				if gHi > h and mid > h then
					mi = ceilIdx
				end
			end
			if c > g then
				mi = ceilIdx
			end
			if solid > 1 then
				solid = 1
			elseif solid < 0.02 then
				solid = 0
			end
			return solid, mi, l
		end
		return at, top
	end

	local top = t.top or 0
	if roof then
		top = math.max(top, roof)
	end
	if level then
		top = math.max(top, level)
	end
	local gx0, gz0 = floor4(x0), floor4(z0)
	local gx1, gz1 = ceil4(x1), ceil4(z1)
	local minY = floor4(floorY) - RES
	local maxY = ceil4(top) + RES * 2
	local colsX, colsZ = (gx1 - gx0) // RES, (gz1 - gz0) // RES
	local chunksX, chunksZ = math.ceil(colsX / CHUNK), math.ceil(colsZ / CHUNK)
	local total = chunksX * chunksZ
	local useChannels = true
	local air, waterMat = Enum.Material.Air, Enum.Material.Water
	local done, voxels = 0, 0
	log(("terrain: %dx%d nodes, cell %d, %d chunks, Y %d..%d"):format(nx, nz, cell, total, minY, maxY))

	-- SKYRALLY PATCH (terrain bake): every voxel the loop below can write lies in these cells (inclusive)
	local cellMin = Vector3int16.new(gx0 // RES, minY // RES, gz0 // RES)
	local cellMax = Vector3int16.new(gx0 // RES + colsX - 1, maxY // RES - 1, gz0 // RES + colsZ - 1)
	terrainCells = { cellMin, cellMax }
	local bakes = ServerStorage:FindFirstChild("TerrainBakes")
	local bake = bakes and bakes:FindFirstChild(DATA.name)
	if bake and bake:IsA("TerrainRegion") and bake:GetAttribute("TerrainHash") == TERRAIN_HASH then
		terrainBaked = pcall(function()
			terrain:PasteRegion(bake, cellMin, true)
		end)
		log(("terrain bake %s %s (%.1fs)"):format(TERRAIN_HASH, if terrainBaked then "pasted" else "FAILED, building", os.clock() - T0))
	elseif bake then
		log(("terrain bake ignored: hash %s, this builder %s"):format(tostring(bake:GetAttribute("TerrainHash")), TERRAIN_HASH))
	end

	for cz = 0, (if terrainBaked then -1 else chunksZ - 1) do
		for cx = 0, chunksX - 1 do
			local nX = math.min(CHUNK, colsX - cx * CHUNK)
			local nZ = math.min(CHUNK, colsZ - cz * CHUNK)
			local ax, az = gx0 + cx * CHUNK * RES, gz0 + cz * CHUNK * RES
			local columns = table.create(nX * nZ)
			local chunkTop = -math.huge
			for k = 1, nZ do
				local wz = az + (k - 1) * RES + RES / 2
				for i = 1, nX do
					local wx = ax + (i - 1) * RES + RES / 2
					local at, ctop = column(height(wx, wz), mat(wx, wz), if ceiling then ceiling(wx, wz) else nil)
					columns[(k - 1) * nX + i] = at
					if ctop > chunkTop then
						chunkTop = ctop
					end
				end
			end
			local ya = minY
			local yb = math.min(maxY, ceil4(chunkTop) + RES)
			local layers = math.max(1, (yb - ya) // RES)
			local solidMat, solidOcc, liquidOcc = table.create(nX), table.create(nX), table.create(nX)
			for i = 1, nX do
				local mx, ox, lx = table.create(layers), table.create(layers), table.create(layers)
				for j = 1, layers do
					local y0 = ya + (j - 1) * RES
					local mz, oz, lz = table.create(nZ), table.create(nZ), table.create(nZ)
					for k = 1, nZ do
						local solid, mi, l = columns[(k - 1) * nX + i](y0)
						if solid > 0 then
							mz[k] = palMat[mi] or defaultMat
							oz[k] = solid
							voxels += 1
						else
							mz[k] = air
							oz[k] = 0
						end
						lz[k] = l
					end
					mx[j], ox[j], lx[j] = mz, oz, lz
				end
				solidMat[i], solidOcc[i], liquidOcc[i] = mx, ox, lx
			end
			local region = Region3.new(Vector3.new(ax, ya, az), Vector3.new(ax + nX * RES, ya + layers * RES, az + nZ * RES))
			local ok = false
			if useChannels then
				ok = pcall(function()
					terrain:WriteVoxelChannels(region, RES, {
						SolidMaterial = solidMat,
						SolidOccupancy = solidOcc,
						LiquidOccupancy = liquidOcc,
					})
				end)
				if not ok then
					useChannels = false
					log("WriteVoxelChannels unavailable, using WriteVoxels")
				end
			end
			if not ok then
				-- classic API: one material per voxel; mostly-empty underwater voxels become water
				for i = 1, nX do
					for j = 1, layers do
						local mj, oj, lj = solidMat[i][j], solidOcc[i][j], liquidOcc[i][j]
						for k = 1, nZ do
							if lj[k] > 0 and oj[k] < 0.5 then
								mj[k] = waterMat
								oj[k] = math.min(1, oj[k] + lj[k])
							end
						end
					end
				end
				terrain:WriteVoxels(region, RES, solidMat, solidOcc)
			end
			done += 1
			if done % 6 == 0 or done == total then
				log(("terrain chunk %d/%d"):format(done, total))
			end
			task.wait()
		end
	end

	-- one colour per terrain material: the palette entry used by the most nodes wins
	local counts = {}
	for _, m in M do
		counts[m] = (counts[m] or 0) + 1
	end
	local best = {}
	for i, e in t.palette or {} do
		local m = palMat[i]
		local n = counts[i] or 0
		if best[m] == nil or n > best[m].n then
			best[m] = { color = e.color, n = n }
		end
	end
	for m, e in best do
		pcall(function()
			terrain:SetMaterialColor(m, color(e.color))
		end)
	end
	if water and not water.lava then
		terrain.WaterColor = color(water.color, terrain.WaterColor)
		terrain.WaterTransparency = clamp(water.transparency or 0.3, 0, 1)
		local lw = DATA.lighting and DATA.lighting.water
		terrain.WaterReflectance = (lw and lw.reflectance) or 0.45
		terrain.WaterWaveSize = (lw and lw.waveSize) or 0.08
		terrain.WaterWaveSpeed = (lw and lw.waveSpeed) or 8
	end
	pcall(function()
		terrain.Decoration = false
	end)
	log(("terrain done: %d solid voxels, channels=%s (%.1fs)"):format(voxels, tostring(useChannels), os.clock() - T0))
end

local okTerrain, errTerrain = pcall(buildTerrain, DATA.terrain)
if not okTerrain then
	buildErrors += 1 -- SKYRALLY PATCH
	warn(TAG, "terrain FAILED:", errTerrain)
end

------------------------------------------------------------------ prefabs
local HALF_PI = math.pi / 2
-- SKYRALLY PATCH: shared folders (Workspace.Maps, ServerStorage.30MAPS_Templates) are created once and
-- never replaced; a build replaces only its own <name> child
local function ensureFolder(parent: Instance, name: string): Instance
	local existing = parent:FindFirstChild(name)
	if existing then
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end
local function replaceFolder(parent: Instance, name: string): Folder
	local old = parent:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- SKYRALLY PATCH: ServerStorage.30MAPS_Templates.<name>, recreated before this build makes any template,
-- so rebuilds and several maps do not pile up templates
local templateFolder = replaceFolder(ensureFolder(ServerStorage, "30MAPS_Templates"), DATA.name)

-- cone footprint (vertices at pi/n + k*2pi/n, x = R sin, z = R cos)
local function coneBounds(n)
	local R = 0.5 / math.cos(math.pi / n)
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for k = 0, n - 1 do
		local a = math.pi / n + k * 2 * math.pi / n
		local x, z = R * math.sin(a), R * math.cos(a)
		minX, maxX = math.min(minX, x), math.max(maxX, x)
		minZ, maxZ = math.min(minZ, z), math.max(maxZ, z)
	end
	return maxX - minX, maxZ - minZ, (minX + maxX) / 2, (minZ + maxZ) / 2
end

-- n-sided pyramid via CSG (intersection of n wedges with a slab), built at 10x for precision
local function buildCone(n)
	local SCALE = 10
	local r, h = 0.5 * SCALE, 1 * SCALE
	local R = r / math.cos(math.pi / n)
	local temp = Instance.new("Folder")
	temp.Name = "30MAPS_ConeWork"
	temp.Parent = workspace
	local base = Instance.new("Part")
	base.Anchored = true
	base.Size = Vector3.new(4 * R, h, 4 * R)
	base.CFrame = CFrame.new(0, h / 2, 0)
	base.Parent = temp
	local wedges = {}
	for j = 0, n - 1 do
		local phi = j * 2 * math.pi / n
		local w = Instance.new("WedgePart")
		w.Anchored = true
		w.Size = Vector3.new(4 * R, 4 * h, 4 * r)
		w.CFrame = CFrame.Angles(0, phi + math.pi, 0) * CFrame.new(0, 2 * h, r)
		w.Parent = temp
		table.insert(wedges, w)
	end
	local ok, result = pcall(function()
		return base:IntersectAsync(wedges)
	end)
	temp:Destroy()
	if not ok or result == nil then
		log("cone CSG failed for n=" .. n .. ": " .. tostring(result))
		return nil
	end
	local bx, bz = coneBounds(n)
	result.Anchored = true
	result.UsePartColor = true
	result.Size = Vector3.new(bx, 1, bz)
	result.CFrame = CFrame.identity
	result.Name = "Cone" .. n
	return result
end

local coneCache = {}
local csgOk = true
local function coneTemplate(n)
	local c = coneCache[n]
	if c then
		return c
	end
	local bx, bz, cx, cz = coneBounds(n)
	local part = if csgOk then buildCone(n) else nil
	if part == nil then
		csgOk = false
	end
	c = { part = part, bx = bx, bz = bz, cx = cx, cz = cz }
	coneCache[n] = c
	return c
end

local function style(p, colour, matName, extra)
	p.Anchored = true
	p.Color = color(colour)
	local m = material(matName, Enum.Material.SmoothPlastic)
	p.Material = m
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local alpha = if extra and extra.a then extra.a else 0
	if m == Enum.Material.Glass or m == Enum.Material.Ice then
		alpha = math.min(0.65, if alpha > 0 then alpha else 0.4)
	end
	if alpha > 0 then
		p.Transparency = alpha
		p.CastShadow = false
	end
	if m == Enum.Material.Neon then
		p.CastShadow = false
	end
	if extra and extra.nc then
		p.CanCollide = false
		p.CanTouch = false
	end
end

local lightsOn = not (DATA.lighting and DATA.lighting.lights and DATA.lighting.lights.on == false)

-- part spec: { shape, x, y, z, sx, sy, sz, rx, ry, rz, colour, material, extra? }
-- shapes: B block, W wedge, S ball (ellipsoid), C cylinder (axis = local Y), K n-sided cone
local function makeParts(spec)
	local shape = spec[1]
	local x, y, z = spec[2], spec[3], spec[4]
	local sx, sy, sz = spec[5], spec[6], spec[7]
	local rx, ry, rz = spec[8] or 0, spec[9] or 0, spec[10] or 0
	local colour, matName, extra = spec[11], spec[12], spec[13]
	local cf = CFrame.new(x, y, z)
	if rx ~= 0 or ry ~= 0 or rz ~= 0 then
		cf *= CFrame.fromEulerAnglesYXZ(math.rad(rx), math.rad(ry), math.rad(rz))
	end
	local out = {}
	if shape == "W" then
		local p = Instance.new("WedgePart")
		p.Size = Vector3.new(sx, sy, sz)
		p.CFrame = cf
		table.insert(out, p)
	elseif shape == "S" then
		local p = Instance.new("Part")
		p.Size = Vector3.new(sx, sy, sz)
		p.CFrame = cf
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
		table.insert(out, p)
	elseif shape == "C" then
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(sy, sx, sz) -- Roblox cylinders run along local X
		p.CFrame = cf * CFrame.Angles(0, 0, HALF_PI)
		table.insert(out, p)
	elseif shape == "K" then
		local n = math.clamp(math.floor(tonumber(extra and extra.n) or 6), 3, 24)
		local tpl = coneTemplate(n)
		if tpl.part then
			local p = tpl.part:Clone()
			p.Size = Vector3.new(tpl.bx * sx, sy, tpl.bz * sz)
			p.CFrame = cf * CFrame.new(tpl.cx * sx, 0, tpl.cz * sz)
			table.insert(out, p)
		else
			for i = 1, 3 do -- fallback: three tapered tiers
				local f = 1 - (i - 0.5) / 3
				local tierH = sy / 3
				local ty = -sy / 2 + tierH * (i - 0.5)
				local p = Instance.new("Part")
				if n == 4 then
					p.Size = Vector3.new(sx * f, tierH, sz * f)
					p.CFrame = cf * CFrame.new(0, ty, 0)
				else
					p.Shape = Enum.PartType.Cylinder
					p.Size = Vector3.new(tierH, sx * f, sz * f)
					p.CFrame = cf * CFrame.new(0, ty, 0) * CFrame.Angles(0, 0, HALF_PI)
				end
				table.insert(out, p)
			end
		end
	else
		local p = Instance.new("Part")
		p.Size = Vector3.new(sx, sy, sz)
		p.CFrame = cf
		table.insert(out, p)
	end
	for i, p in out do
		style(p, colour, matName, extra)
		if i == 1 and extra and type(extra.l) == "table" then
			local l = extra.l
			local light = Instance.new("PointLight")
			light.Range = math.clamp(tonumber(l[1]) or 12, 0, 60)
			light.Brightness = tonumber(l[2]) or 1
			light.Color = color(l[3], Color3.fromRGB(255, 200, 120))
			light.Shadows = l[4] == true
			light.Enabled = lightsOn
			light.Parent = p
		end
	end
	return out
end

local templates = {}
local function template(index)
	local m = templates[index]
	if m then
		return m
	end
	local pf = DATA.prefabs[index]
	m = Instance.new("Model")
	m.Name = (string.gsub(pf.key, "#.*$", ""))
	for i, spec in pf.parts do
		for j, p in makeParts(spec) do
			p.Name = if j == 1 then "P" .. i else ("P%d_%d"):format(i, j)
			p.Parent = m
		end
	end
	m.WorldPivot = CFrame.identity
	m:SetAttribute("Prefab", pf.key)
	m.Parent = templateFolder
	templates[index] = m
	return m
end

-- scale a clone about its pivot (sphere meshes and CSG cones follow part size)
local function scaleModel(model, s)
	if math.abs(s - 1) < 1e-4 then
		return
	end
	local pivot = model:GetPivot()
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local rel = pivot:ToObjectSpace(d.CFrame)
			d.Size *= s
			d.CFrame = pivot * (CFrame.new(rel.Position * s) * rel.Rotation)
		elseif d:IsA("PointLight") then
			d.Range = math.min(60, d.Range * s)
		end
	end
end

