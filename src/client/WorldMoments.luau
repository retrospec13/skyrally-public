---------------------------------------------------------------------------------------------------- world text (pooled)

type Pop = { att: Attachment, gui: BillboardGui, label: TextLabel, token: number }
local pops: { [string]: Pop } = {}

local function pop(key: string): Pop
	local existing = pops[key]
	if existing and existing.att.Parent then
		return existing
	end
	local att = Instance.new("Attachment")
	att.Name = "WorldMomentsText_" .. key
	att.Parent = workspace.Terrain
	local gui = Instance.new("BillboardGui")
	gui.Name = "WorldMomentsText"
	gui.Adornee = att
	gui.LightInfluence = 0
	gui.MaxDistance = 650
	gui.Enabled = false
	gui.Parent = att
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = CREAM
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = INK
	stroke.Thickness = 3
	stroke.Parent = label
	local p = { att = att, gui = gui, label = label, token = 0 }
	pops[key] = p
	return p
end

-- Comic text in the world: pops in with a back-ease to w x h studs, optionally rises `rise` studs, fades at the end.
local function showText(key: string, text: string, color: Color3, pos: Vector3, w: number, h: number, dur: number, rise: number)
	local p = pop(key)
	p.label.Text = text
	p.label.TextColor3 = color
	p.label.TextTransparency = 0
	p.att.WorldPosition = pos
	p.gui.Size = UDim2.fromScale(w * 0.3, h * 0.3)
	p.gui.Enabled = true
	p.token += 1
	local mine = p.token
	animate(dur, function(k: number, t: number)
		if p.token ~= mine then
			return -- a newer line took this slot ("AH..." -> "AH... AH...")
		end
		local s = 0.3 + 0.7 * easeOutBack(math.clamp(t / 0.22, 0, 1))
		p.gui.Size = UDim2.fromScale(w * s, h * s)
		p.att.WorldPosition = pos + Vector3.new(0, rise * k, 0)
		p.label.TextTransparency = math.clamp((k - 0.7) / 0.3, 0, 1)
	end, function()
		if p.token == mine then
			p.gui.Enabled = false
		end
	end)
end

---------------------------------------------------------------------------------------------------- screen effects

local screen: ScreenGui? = nil
local edges: { Frame } = {}
local drops: { ImageLabel } = {}

local function screenGui(): ScreenGui?
	if screen and screen.Parent then
		return screen
	end
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return nil
	end
	local g = Instance.new("ScreenGui")
	g.Name = "WorldMomentsFx"
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = true
	g.DisplayOrder = 3
	g.Parent = pg
	table.clear(edges)
	table.clear(drops)
	-- Soot vignette: four edge bands, opaque at the screen edge and clear by 22% in, so the route and the next gate
	-- in the middle of the screen stay readable (ART_BAR VFX restraint).
	for _, e in {
		{ pos = UDim2.fromScale(0, 0), size = UDim2.fromScale(1, 0.22), rot = 90 },
		{ pos = UDim2.fromScale(0, 0.78), size = UDim2.fromScale(1, 0.22), rot = -90 },
		{ pos = UDim2.fromScale(0, 0), size = UDim2.fromScale(0.22, 1), rot = 0 },
		{ pos = UDim2.fromScale(0.78, 0), size = UDim2.fromScale(0.22, 1), rot = 180 },
	} do
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = SOOT
		f.BackgroundTransparency = 1
		f.Position = e.pos
		f.Size = e.size
		f.Active = false
		f.Parent = g
		local grad = Instance.new("UIGradient")
		grad.Rotation = e.rot
		grad.Transparency = ns({ { 0, 0 }, { 1, 1 } })
		grad.Parent = f
		table.insert(edges, f)
	end
	-- Fountain splash: a few droplets that run down the screen.
	for _ = 1, 6 do
		local d = Instance.new("ImageLabel")
		d.BackgroundTransparency = 1
		d.Image = tex("water_droplet")
		d.ImageColor3 = rgb(225, 248, 255)
		d.ImageTransparency = 1
		d.AnchorPoint = Vector2.new(0.5, 0.5)
		d.Active = false
		d.Parent = g
		table.insert(drops, d)
	end
	screen = g
	return g
end

local vignetteToken = 0
local function sootVignette(strength: number)
	if strength <= 0 or not screenGui() then
		return
	end
	vignetteToken += 1
	local my = vignetteToken
	local peak = math.clamp(strength, 0, 1) * 0.6
	animate(0.75, function(_k: number, t: number)
		if my ~= vignetteToken then
			return
		end
		-- the dark peak holds for under two frames, then the soot settles off the edges
		local a = if t < 0.03 then peak else peak * 0.55 * math.max(0, 1 - (t - 0.03) / 0.72)
		for _, f in edges do
			f.BackgroundTransparency = 1 - a
		end
	end, function()
		if my == vignetteToken then
			for _, f in edges do
				f.BackgroundTransparency = 1
			end
		end
	end)
end

local function screenSplash()
	if not screenGui() then
		return
	end
	local rng = Random.new()
	local starts = table.create(#drops)
	for i, d in drops do
		local px = rng:NextNumber(0.12, 0.88)
		local py = rng:NextNumber(0.08, 0.6)
		local sz = rng:NextInteger(46, 96)
		d.Size = UDim2.fromOffset(sz, sz)
		d.Position = UDim2.fromScale(px, py)
		d.Rotation = rng:NextNumber(-20, 20)
		starts[i] = Vector2.new(px, py)
	end
	animate(1.4, function(k: number)
		for i, d in drops do
			local s = starts[i]
			d.Position = UDim2.fromScale(s.X, s.Y + 0.07 * k * k + 0.01 * i * k)
			d.ImageTransparency = 0.15 + 0.85 * k * k
		end
	end, function()
		for _, d in drops do
			d.ImageTransparency = 1
		end
	end)
end

---------------------------------------------------------------------------------------------------- landmarks

type Landmark = {
	def: Rules.LandmarkDef,
	inst: Instance,
	answer: string,
	reach: number,
	readyAt: number,
	cf: CFrame,
	size: Vector3,
	moving: boolean,
	anchorLocal: Vector3, -- in the pivot space of inst (static landmarks)
}

local function activeRoot(): Instance?
	return TrackRegistry.getRoot()
end

local function pivotOf(inst: Instance): CFrame?
	if inst:IsA("Model") then
		return inst:GetPivot()
	elseif inst:IsA("BasePart") then
		return inst.CFrame
	end
	return nil
end

-- Parts of `inst` except those under a spinning model (WorldAnim's SpinRPM sails reach above the windmill cap).
local function staticParts(inst: Instance): { BasePart }
	local spinners = {}
	for _, d in inst:GetDescendants() do
		if d:IsA("Model") and d:GetAttribute("SpinRPM") ~= nil then
			table.insert(spinners, d)
		end
	end
	local out = {}
	for _, d in inst:GetDescendants() do
		if d:IsA("BasePart") then
			local skip = false
			for _, s in spinners do
				if d:IsDescendantOf(s) then
					skip = true
					break
				end
			end
			if not skip then
				table.insert(out, d)
			end
		end
	end
	if inst:IsA("BasePart") then
		table.insert(out, inst)
	end
	return out
end

local function boundsOf(inst: Instance, parts: { BasePart }?): (CFrame?, Vector3?)
	if inst:IsA("Model") then
		local cf, size = inst:GetBoundingBox()
		return cf, size
	elseif inst:IsA("BasePart") then
		return inst.CFrame, inst.Size
	end
	local list: { BasePart } = if parts then parts else staticParts(inst)
	if #list == 0 then
		return nil, nil
	end
	local lo = Vector3.new(math.huge, math.huge, math.huge)
	local hi = -lo
	for _, p in list do
		local h = p.Size * 0.5
		lo = lo:Min(p.Position - h)
		hi = hi:Max(p.Position + h)
	end
	return CFrame.new((lo + hi) * 0.5), hi - lo
end

-- The sauropod's nose in world space and the sneeze direction (horizontal), from the HeadOffset attribute the server
-- publishes, else the same mesh measure the server uses.
local function noseOf(statue: Model): (Vector3, Vector3)
	local pivot = statue:GetPivot()
	local off = statue:GetAttribute("HeadOffset")
	local local_: Vector3
	if typeof(off) == "Vector3" then
		local_ = off
	else
		local found: Vector3? = nil
		for _, c in statue:GetChildren() do
			if c:IsA("MeshPart") then
				found = pivot:PointToObjectSpace(c.CFrame:PointToWorldSpace(Rules.noseLocal(c.Size)))
				break
			end
		end
		local_ = found or Vector3.new(-30, 55, 0)
	end
	local dir = Rules.headFrame(local_)
	return pivot:PointToWorldSpace(local_), pivot:VectorToWorldSpace(dir)
end

local found: { Landmark } = {}
local foundRoot: Instance? = nil
local scannedAt = -math.huge

local function rescan(root: Instance)
	local previous: { [Instance]: number } = {}
	for _, e in found do
		previous[e.inst] = e.readyAt
	end
	table.clear(found)
	for _, def in Rules.LANDMARKS do
		local first = root:FindFirstChild(def.name, true)
		local parent = first and first.Parent
		if parent then
			for _, inst in parent:GetChildren() do
				if inst.Name == def.name then
					local parts = staticParts(inst)
					local cf, size = boundsOf(inst, parts)
					local pivot = pivotOf(inst) or cf
					if cf and size and pivot then
						local anchorWorld = cf.Position + Vector3.new(0, size.Y * 0.5, 0)
						if def.anchor == "top" then
							local best, bestTop = nil :: BasePart?, -math.huge
							for _, p in parts do
								local top = p.Position.Y + p.Size.Y * 0.5
								if top > bestTop then
									best, bestTop = p, top
								end
							end
							if best then
								anchorWorld = Vector3.new(best.Position.X, bestTop, best.Position.Z)
							end
						end
						local answer = inst:GetAttribute("HornAnswer")
						local reach = inst:GetAttribute("HornAnswerReach")
						table.insert(found, {
							def = def,
							inst = inst,
							answer = if type(answer) == "string" then answer else def.answer,
							reach = if type(reach) == "number" then reach else Rules.HORN_REACH,
							readyAt = previous[inst] or -math.huge,
							cf = cf,
							size = size,
							moving = def.anchor == "nose",
							anchorLocal = (pivot :: CFrame):PointToObjectSpace(anchorWorld),
						})
					end
				end
			end
		end
	end
end

local function landmarks(): { Landmark }
	local root = activeRoot()
	if not root then
		table.clear(found)
		foundRoot = nil
		return found
	end
	local stale = root ~= foundRoot
	for _, e in found do
		if not e.inst.Parent then
			stale = true
			break
		end
	end
	-- An empty scan is retried every few seconds: the map may still be building.
	if stale or (#found == 0 and os.clock() - scannedAt > 3) then
		foundRoot = root
		scannedAt = os.clock()
		rescan(root)
	end
	for _, e in found do
		if e.moving then
			local cf, size = boundsOf(e.inst)
			if cf and size then
				e.cf, e.size = cf, size
			end
		end
	end
	return found
end

local function anchorOf(e: Landmark): Vector3
	local inst = e.inst
	if e.moving and inst:IsA("Model") then
		local nose = noseOf(inst)
		return nose
	end
	local pivot = pivotOf(e.inst) or e.cf
	return pivot:PointToWorldSpace(e.anchorLocal)
end

---------------------------------------------------------------------------------------------------- horn answers

local UP = Vector3.yAxis
local heard: { [string]: boolean } = {}
local wobbling: { [Instance]: boolean } = {}

local function upCF(pos: Vector3): CFrame
	return CFrame.lookAt(pos, pos + UP)
end

local function answerFoghorn(e: Landmark, top: Vector3, near: boolean)
	local center = e.cf.Position
	sfx("foghorn", "ans_foghorn", center, 1, 1, 900)
	burst("mist", upCF(top + Vector3.new(0, 2, 0)), 1)
	if near then
		addTrauma(0.14)
	end
	-- Rigging rattle: the rigging shivers about its own pivot for a second (local-only CFrame, restored exactly).
	local rig = e.inst.Parent and e.inst.Parent:FindFirstChild("GalleonRigging")
	if rig and rig:IsA("Model") and not wobbling[rig] then
		wobbling[rig] = true
		local base = rig:GetPivot()
		animate(1.15, function(k: number, t: number)
			if not rig.Parent then
				return
			end
			local fade = (1 - k) * math.min(1, t / 0.12)
			rig:PivotTo(base * CFrame.Angles(0.004 * fade * math.sin(t * 31), 0, 0.006 * fade * math.sin(t * 37)))
		end, function()
			if rig.Parent then
				rig:PivotTo(base)
			end
			wobbling[rig] = nil
		end)
	end
end

local function answerFountain(e: Landmark, top: Vector3)
	sfx("fountain", "ans_fountain", top, 1, 1, 500)
	burst("jet", upCF(top), 1)
	local basin = Vector3.new(top.X, e.cf.Position.Y - e.size.Y * 0.5 + 3, top.Z)
	task.delay(0.95, function()
		Vfx.burst("splash", upCF(basin), 2.5)
		Vfx.burst("splash", upCF(top + Vector3.new(0, 18, 0)), 1)
		local reachSplash = math.max(e.size.X, e.size.Z) * 0.5 + 18
		if (focus() - basin).Magnitude < reachSplash then
			screenSplash()
		end
	end)
end

-- The cuckoo: a little bird on a spring, built once and parked out of the world between calls.
type Bird = { model: Model, parts: { BasePart }, offsets: { CFrame }, spring: BasePart, busy: boolean }
local bird: Bird? = nil

local function birdPart(model: Model, shape: string, size: Vector3, color: Color3, material: Enum.Material?): BasePart
	local p: BasePart
	if shape == "wedge" then
		p = Instance.new("WedgePart")
	else
		local part = Instance.new("Part")
		part.Shape = if shape == "ball" then Enum.PartType.Ball elseif shape == "cyl" then Enum.PartType.Cylinder else Enum.PartType.Block
		p = part
	end
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = model
	return p
end

local function cuckooBird(): Bird
	if bird and bird.model then
		return bird
	end
	local m = Instance.new("Model")
	m.Name = "HornAnswerCuckoo"
	local parts, offsets = {}, {}
	local function add(shape: string, size: Vector3, color: Color3, off: CFrame, mat: Enum.Material?)
		table.insert(parts, birdPart(m, shape, size, color, mat))
		table.insert(offsets, off)
	end
	add("ball", Vector3.new(2.2, 2.2, 2.2), rgb(255, 206, 84), CFrame.new()) -- body
	add("ball", Vector3.new(1.6, 1.6, 1.6), rgb(255, 214, 102), CFrame.new(0, 1.3, -0.5)) -- head
	add("wedge", Vector3.new(0.5, 0.45, 0.9), rgb(255, 128, 40), CFrame.new(0, 1.2, -1.55) * CFrame.Angles(0, math.pi, 0)) -- beak
	add("ball", Vector3.new(0.34, 0.34, 0.34), INK, CFrame.new(0.42, 1.55, -1.15)) -- eyes
	add("ball", Vector3.new(0.34, 0.34, 0.34), INK, CFrame.new(-0.42, 1.55, -1.15))
	add("block", Vector3.new(0.25, 1.1, 1.4), rgb(214, 136, 50), CFrame.new(1.12, 0.1, 0.1)) -- wings
	add("block", Vector3.new(0.25, 1.1, 1.4), rgb(214, 136, 50), CFrame.new(-1.12, 0.1, 0.1))
	add("wedge", Vector3.new(0.3, 0.6, 1.2), rgb(214, 136, 50), CFrame.new(0, 0.2, 1.35)) -- tail
	local spring = birdPart(m, "cyl", Vector3.new(1, 0.5, 0.5), rgb(196, 200, 208), Enum.Material.Metal)
	bird = { model = m, parts = parts, offsets = offsets, spring = spring, busy = false }
	return bird :: Bird
end

local function answerCuckoo(top: Vector3, honkerPos: Vector3)
	local b = cuckooBird()
	if b.busy then
		return
	end
	b.busy = true
	b.model.Parent = host()
	local flat = Vector3.new(honkerPos.X - top.X, 0, honkerPos.Z - top.Z)
	local face = if flat.Magnitude > 0.1 then flat.Unit else Vector3.new(0, 0, -1)
	local baseRot = CFrame.lookAt(Vector3.zero, face)
	local hidden = top - Vector3.new(0, 2.6, 0)
	sfx("cuckoo", "ans_cuckoo", top, 1, 1, 450)
	-- Bows line up with the four notes of ans_cuckoo (two "cuc-koo" calls: 0, 0.26 and 0.62, 0.88 s).
	local calls = { 0.12, 0.38, 0.74, 1.0 }
	animate(1.95, function(_k: number, t: number)
		local up: number
		if t < 0.2 then
			up = easeOutBack(t / 0.2)
		elseif t < 1.55 then
			up = 1
		else
			local r = math.clamp((t - 1.55) / 0.3, 0, 1)
			up = 1 - r * r
		end
		local bow = 0
		for _, c in calls do
			bow = math.max(bow, 1 - math.abs(t - c) / 0.11)
		end
		local y = hidden.Y + 5.8 * up
		local root = CFrame.new(hidden.X, y, hidden.Z) * baseRot * CFrame.Angles(math.rad(-26) * bow, 0, 0)
		for i, p in b.parts do
			p.CFrame = root * b.offsets[i]
		end
		local len = math.max(0.2, y - 1 - hidden.Y)
		b.spring.Size = Vector3.new(len, 0.5, 0.5)
		b.spring.CFrame = CFrame.new(hidden.X, hidden.Y + len * 0.5, hidden.Z) * CFrame.Angles(0, 0, math.pi / 2)
	end, function()
		b.model.Parent = nil
		b.busy = false
	end)
end

local function answerPuff(top: Vector3)
	sfx("puff", "ans_puff", top, 1, 1, 400)
	local entry = pool("ringPuff")
	if not entry then
		return
	end
	local center = top + Vector3.new(0, 1.5, 0)
	for _, dir in Rules.ringDirections(16, 0.7) do
		local flat = Vector3.new(dir.X, 0, dir.Z)
		local from = center + flat * 1.4
		entry.att.WorldCFrame = CFrame.lookAt(from, from + dir)
		for _, pe in entry.emitters do
			pe:Emit(1)
		end
	end
	burst("mist", upCF(top), 0.25)
end

local function answerChime(top: Vector3)
	sfx("chime", "ans_chime", top, 0.9, 1, 600)
	Vfx.burst("ringPass", upCF(top + Vector3.new(0, 3, 0)), 1)
	Vfx.burst("pickup", upCF(top + Vector3.new(0, 3, 0)), 1)
	task.delay(0.42, function()
		Vfx.burst("ringPass", upCF(top + Vector3.new(0, 7, 0)), 0.7)
	end)
end

local function answerHonk(e: Landmark)
	local inst = e.inst
	if not inst:IsA("Model") then
		return
	end
	local nose, fwd = noseOf(inst)
	-- a sleepy, higher honk (the sneeze cue re-pitched; REMARKABLE asset summary: ans_honk = sneeze_honk at 1.3)
	sfx("honk", if AUDIO.ans_honk then "ans_honk" else "sneeze_honk", nose, 0.75, if AUDIO.ans_honk then 1 else 1.3, 700)
	burst("mist", CFrame.lookAt(nose, nose + fwd), 0.3)
	showText("zzz", "z  z  Z", CREAM, nose + Vector3.new(0, 6, 0), 12, 4.5, 2.4, 9)
end

local function playAnswer(e: Landmark, honkerPos: Vector3, mine: boolean)
	if not e.inst.Parent then
		return
	end
	local top = anchorOf(e)
	local here = focus()
	local near = (here - top).Magnitude < e.reach + 30
	if e.answer == "foghorn" then
		answerFoghorn(e, top, near)
	elseif e.answer == "fountain" then
		answerFountain(e, top)
	elseif e.answer == "cuckoo" then
		answerCuckoo(top, honkerPos)
	elseif e.answer == "puff" then
		answerPuff(top)
	elseif e.answer == "chime" then
		answerChime(top)
	elseif e.answer == "honk" then
		answerHonk(e)
	else
		return
	end
	-- Heard: this client honked, or it was close enough to hear the answer.
	if mine or (here - top).Magnitude < 220 then
		local n, complete = Rules.markHeard(heard, e.answer)
		LocalPlayer:SetAttribute("HornAnswersHeard", n)
		if complete then
			task.delay(1.2, function()
				pcall(TrackFlow.toast, Rules.SESSION_TOAST, GOLD, 4)
				Vfx.burst("confetti", upCF(focus() + Vector3.new(0, 4, 0)), 1)
			end)
			print("[SkyRally][MOMENTS] horn answers 6/6 this session")
		end
	end
end

local function onHorn(userId: number)
	local model = vehicleOf(userId)
	local hull = model and hullOf(model)
	if not hull then
		return
	end
	local list = landmarks()
	if #list == 0 then
		return
	end
	local now = os.clock()
	local idx = Rules.pickLandmark(list :: any, hull.Position, now)
	if not idx then
		return
	end
	local e = list[idx]
	e.readyAt = now + Rules.HORN_COOLDOWN
	local honkerPos = hull.Position
	task.delay(Rules.HORN_DELAY, playAnswer, e, honkerPos, userId == LocalPlayer.UserId)
end

---------------------------------------------------------------------------------------------------- sauropod sneeze

local function statue(): Model?
	local lm = TrackRegistry.getLandmarks()
	local s = lm and lm:FindFirstChild("RoamingGreenSauropod")
	return if s and s:IsA("Model") then s else nil
end

-- A tiny stand-in hatchling (used when the Cinderwing mesh template is not in ReplicatedStorage).
local function standInHatchling(): (Model, { BasePart }, { CFrame }, { number })
	local m = Instance.new("Model")
	m.Name = "SauropodHatchling"
	local dark, accent = rgb(46, 36, 40), rgb(255, 110, 30)
	local parts, offsets, flap = {}, {}, {}
	local function add(shape: string, size: Vector3, color: Color3, off: CFrame, wing: number, mat: Enum.Material?)
		table.insert(parts, birdPart(m, shape, size, color, mat))
		table.insert(offsets, off)
		table.insert(flap, wing)
	end
	add("ball", Vector3.new(1.7, 1.5, 2.1), dark, CFrame.new(), 0)
	add("ball", Vector3.new(1.2, 1.2, 1.2), dark, CFrame.new(0, 0.55, -1.25), 0)
	add("wedge", Vector3.new(0.45, 0.4, 0.9), accent, CFrame.new(0, 0.45, -2.1) * CFrame.Angles(0, math.pi, 0), 0)
	add("ball", Vector3.new(0.3, 0.3, 0.3), rgb(255, 230, 120), CFrame.new(0.32, 0.8, -1.7), 0, Enum.Material.Neon)
	add("ball", Vector3.new(0.3, 0.3, 0.3), rgb(255, 230, 120), CFrame.new(-0.32, 0.8, -1.7), 0, Enum.Material.Neon)
	add("block", Vector3.new(2.4, 0.14, 1.2), accent, CFrame.new(1.25, 0.2, 0.1), 1)
	add("block", Vector3.new(2.4, 0.14, 1.2), accent, CFrame.new(-1.25, 0.2, 0.1), -1)
	add("wedge", Vector3.new(0.3, 0.5, 1.4), accent, CFrame.new(0, 0.1, 1.5), 0, Enum.Material.Neon)
	return m, parts, offsets, flap
end

local function launchHatchling(nose: Vector3, fwd: Vector3)
	local side = fwd:Cross(UP)
	side = if side.Magnitude > 0.01 then side.Unit else Vector3.xAxis
	local template = ReplicatedStorage:FindFirstChild("SauropodHatchlingTemplate")
	local model: Model
	local parts: { BasePart } = {}
	local offsets: { CFrame } = {}
	local flap: { number } = {}
	local yaw = CFrame.identity
	local isMesh = false
	if template and template:IsA("Model") then
		model = template:Clone()
		local cf = model:GetBoundingBox()
		model.WorldPivot = cf
		local deg = template:GetAttribute("YawOffsetDeg")
		yaw = CFrame.Angles(0, math.rad(if type(deg) == "number" then deg else 180), 0)
		isMesh = true
	else
		model, parts, offsets, flap = standInHatchling()
	end
	model.Name = "SauropodHatchling"
	model.Parent = host()
	local trail, trailEmitter = trailRig()
	trailEmitter.Enabled = true
	local squawks = { { at = 0.3, speed = 1.0 }, { at = 1.45, speed = 1.18 }, { at = 2.6, speed = 0.92 } }
	local nextSquawk = 1
	local dur = Rules.HATCHLING_SEC
	animate(dur, function(k: number, t: number)
		local pos = Rules.hatchlingPoint(k, nose, fwd, side)
		local ahead = Rules.hatchlingPoint(math.min(1, k + 0.02), nose, fwd, side)
		local vel = ahead - pos
		local look = if vel.Magnitude > 1e-3 then vel.Unit else fwd
		local flapA = math.sin(t * 2 * math.pi * 7)
		-- tumbles out of the nose for half a second, then rights itself and flaps (a small bob with each beat)
		local tumble = if t < 0.5 then (1 - t / 0.5) * math.pi * 3 else 0
		local root = CFrame.lookAt(pos + UP * (0.35 * flapA), pos + look) * CFrame.Angles(0, 0, tumble + 0.25 * flapA)
		if isMesh then
			model:PivotTo(root * yaw)
		else
			for i, p in parts do
				local w = flap[i]
				if w ~= 0 then
					p.CFrame = root * CFrame.new(0.4 * w, 0.2, 0) * CFrame.Angles(0, 0, w * 0.8 * flapA) * CFrame.new(0.85 * w, 0, 0.1)
				else
					p.CFrame = root * offsets[i]
				end
			end
		end
		trail.WorldPosition = pos
		local sq = squawks[nextSquawk]
		if sq and t >= sq.at then
			nextSquawk += 1
			sfx("squawk", "hatch_squawk", pos, 0.9, sq.speed, 500)
		end
	end, function()
		local last = Rules.hatchlingPoint(1, nose, fwd, side)
		burst("poof", CFrame.new(last), 1)
		trailEmitter.Enabled = false
		model:Destroy()
	end)
end

local inhaleFor: number? = nil -- SauropodInhaleAt of the sequence this client is playing
local snapFor: number? = nil

local function snap(at: number)
	if snapFor == at then
		return
	end
	snapFor = at
	local s = statue()
	if not s then
		return
	end
	local nose, fwd = noseOf(s)
	local spray = (fwd - UP * 0.35).Unit
	local sprayCF = CFrame.lookAt(nose, nose + spray)
	Vfx.burst("crashLava", sprayCF, 2.0)
	burst("soot", sprayCF, 1)
	local d = (focus() - nose).Magnitude
	local trauma = Rules.trauma(d)
	if trauma > 0 then
		addTrauma(trauma)
		sootVignette(trauma / Rules.SHAKE_MAX)
	end
	if workspace:GetAttribute("SauropodHatchling") == true then
		task.delay(0.1, launchHatchling, nose + fwd * 3, fwd)
	end
end

local function onInhale()
	local at = workspace:GetAttribute("SauropodInhaleAt")
	if type(at) ~= "number" or inhaleFor == at then
		return
	end
	local age = workspace:GetServerTimeNow() - at
	if age > Rules.INHALE_SEC + 0.3 or age < -1 then
		return -- joined after it happened
	end
	inhaleFor = at
	local s = statue()
	if not s then
		return
	end
	local remaining = math.max(0, Rules.INHALE_SEC - age)
	if remaining > 0.25 then
		local nose = noseOf(s)
		local hostPart, emitters = inhaleRig()
		hostPart.CFrame = CFrame.new(nose)
		for _, pe in emitters do
			pe.Enabled = true
		end
		-- the nostrils move as the head rears back: the host follows them; the emitters stop 0.15 s before the snap
		animate(remaining, function(_k: number, t: number)
			if s.Parent then
				hostPart.CFrame = CFrame.new((noseOf(s)))
			end
			if t > remaining - 0.15 then
				for _, pe in emitters do
					pe.Enabled = false
				end
			end
		end, function()
			for _, pe in emitters do
				pe.Enabled = false
			end
		end)
		task.delay(math.max(0, remaining - 1.0), function()
			if inhaleFor == at and s.Parent then
				sfx("inhale", "sneeze_inhale", (noseOf(s)), 1, 1, 900)
			end
		end)
		task.delay(0.05, function()
			if inhaleFor == at and s.Parent then
				showText("sneeze", "AH...", CREAM, noseOf(s) + Vector3.new(0, 10, 0), 16, 6, 0.6, 1)
			end
		end)
		task.delay(math.max(0, remaining - 0.62), function()
			if inhaleFor == at and s.Parent then
				showText("sneeze", "AH... AH...", CREAM, noseOf(s) + Vector3.new(0, 11, 0), 24, 8, 0.62, 1)
			end
		end)
	end
	-- the honk swells in just before the snap so its blast lands on the lunge
	task.delay(math.max(0, remaining - 0.12), function()
		if inhaleFor == at and s.Parent then
			sfx("sneeze", "sneeze_honk", (noseOf(s)), 1, 1, 1100)
		end
	end)
	task.delay(remaining + 0.08, snap, at)
end

local function onSneeze()
	local at = workspace:GetAttribute("SauropodSneezeAt")
	if type(at) ~= "number" then
		return
	end
	-- Normally the inhale already scheduled the snap; this covers a client that missed the inhale attribute.
	local inhaleAt = workspace:GetAttribute("SauropodInhaleAt")
	if inhaleFor ~= nil and inhaleFor == inhaleAt then
		return
	end
	if workspace:GetServerTimeNow() - at < 0.5 then
		local key = if type(inhaleAt) == "number" then inhaleAt else at
		inhaleFor = key
		local s = statue()
		if s then
			sfx("sneeze", "sneeze_honk", (noseOf(s)), 1, 1, 1100)
		end
		snap(key)
	end
end

---------------------------------------------------------------------------------------------------- QA

local debugMarks: { BasePart } = {}
local function setDebug(on: boolean)
	for _, p in debugMarks do
		p:Destroy()
	end
	table.clear(debugMarks)
	if not on then
		return
	end
	local here = focus()
	local function mark(pos: Vector3, color: Color3)
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(3, 3, 3)
		p.Material = Enum.Material.Neon
		p.Color = color
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Position = pos
		p.Parent = host()
		table.insert(debugMarks, p)
	end
	for _, e in landmarks() do
		local a = anchorOf(e)
		mark(a, rgb(80, 255, 120))
		print(string.format("[SkyRally][MOMENTS] landmark %s (%s) anchor=(%.0f, %.0f, %.0f) box=%.0fx%.0fx%.0f dist=%.0f reach=%d",
			e.inst:GetFullName(), e.answer, a.X, a.Y, a.Z, e.size.X, e.size.Y, e.size.Z,
			Rules.distToBox(e.cf, e.size, here), e.reach))
	end
	local s = statue()
	if s then
		local nose = noseOf(s)
		mark(nose, rgb(255, 80, 60))
		print(string.format("[SkyRally][MOMENTS] sauropod nose=(%.0f, %.0f, %.0f) dist=%.0f HeadOffset=%s", nose.X, nose.Y, nose.Z,
			(nose - here).Magnitude, tostring(s:GetAttribute("HeadOffset"))))
	end
end

local function onTest()
	local kind = workspace:GetAttribute("WorldMomentsTest")
	if type(kind) ~= "string" or kind == "" then
		return
	end
	local here = focus()
	local best: Landmark? = nil
	local bestD = math.huge
	for _, e in landmarks() do
		if e.answer == kind then
			local d = (e.cf.Position - here).Magnitude
			if d < bestD then
				best, bestD = e, d
			end
		end
	end
	if best then
		playAnswer(best, here, true)
	else
		print("[SkyRally][MOMENTS] no " .. kind .. " landmark on this map")
	end
end

---------------------------------------------------------------------------------------------------- init

function WorldMoments.init()
	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("SkyRallyRemotes", 15)
		local ev = remotes and remotes:WaitForChild("CosmeticEvent", 15)
		if ev and ev:IsA("RemoteEvent") then
			-- Same relay Cosmetics plays the beeps from; validation stays in server/CosmeticService.
			ev.OnClientEvent:Connect(function(kind: any, userId: any, _key: any)
				if kind == "Horn" and type(userId) == "number" then
					onHorn(userId)
				end
			end)
		end
	end)
	workspace:GetAttributeChangedSignal("SauropodInhaleAt"):Connect(onInhale)
	workspace:GetAttributeChangedSignal("SauropodSneezeAt"):Connect(onSneeze)
	RaceAttr.changed("ActiveTrackId", function()
		table.clear(found)
		foundRoot = nil
	end)
	workspace:GetAttributeChangedSignal("WorldMomentsDebug"):Connect(function()
		setDebug(workspace:GetAttribute("WorldMomentsDebug") == true)
	end)
	workspace:GetAttributeChangedSignal("WorldMomentsTest"):Connect(onTest)
	LocalPlayer:SetAttribute("HornAnswersHeard", 0)
	-- Batch 2 set pieces join here (docs/REMARKABLE.md items 13, 21, 22, 25), each in its own module on MomentKit:
	-- the galleon cannons, plank salute and gull rescue; boss defeat gags and retired bosses; the Lost Squeaky Ducks;
	-- the Moon Monorail. One failing module never stops the others.
	local Kit = require(script.Parent:WaitForChild("MomentKit"))
	Kit.setControllers(CarController, FlightController)
	local okUi, RaceUI = pcall(require, script.Parent:WaitForChild("RaceUI"))
	local okMusic, Music = pcall(require, script.Parent:WaitForChild("Music"))
	local raceUI = if okUi then RaceUI else nil
	local music = if okMusic then Music else nil
	local function start(name: string, fn: () -> ())
		local ok, err = pcall(function()
			fn()
		end)
		if not ok then
			warn(string.format("[SkyRally][SETPIECE] %s failed to start: %s", name, tostring(err)))
		end
	end
	start("GalleonMoments", function()
		require(script.Parent:WaitForChild("GalleonMoments")).init(CarController, raceUI)
	end)
	start("BossRetirement", function()
		require(script.Parent:WaitForChild("BossRetirement")).init(TrackFlow)
	end)
	start("DuckMoments", function()
		require(script.Parent:WaitForChild("DuckMoments")).init(TrackFlow, music)
	end)
	start("MoonMonorail", function()
		require(script.Parent:WaitForChild("MoonMonorail")).init(TrackFlow, raceUI)
	end)
	start("VolcanoMoments", function()
		require(script.Parent:WaitForChild("VolcanoMoments")).init(FlightController, raceUI)
	end)
	start("SpaceNeon", function()
		require(script.Parent:WaitForChild("SpaceNeon")).init()
	end)
	start("SnowCrossing", function()
		require(script.Parent:WaitForChild("SnowCrossing")).init()
	end)
end

return WorldMoments
