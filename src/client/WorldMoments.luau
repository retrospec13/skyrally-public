type Pool = { att: Attachment, emitters: { ParticleEmitter }, preset: { Preset } }
local pools: { [string]: Pool } = {}

local function makeEmitter(p: Preset, parent: Instance): ParticleEmitter
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = tex(p.tex)
	pe.Enabled = false
	pe.Rate = 0
	pe.Lifetime = p.lifetime
	pe.Speed = p.speed
	pe.SpreadAngle = p.spread
	pe.Size = p.size
	pe.Transparency = p.transparency
	pe.Color = p.color
	pe.LightEmission = p.lightEmission or 0
	pe.LightInfluence = if (p.lightEmission or 0) > 0.5 then 0 else 1
	pe.Acceleration = p.accel or Vector3.zero
	pe.Drag = p.drag or 0
	pe.Rotation = p.rotation or NumberRange.new(0)
	pe.RotSpeed = p.rotSpeed or NumberRange.new(0)
	pe.Orientation = p.orientation or Enum.ParticleOrientation.FacingCamera
	pe.EmissionDirection = Enum.NormalId.Front
	pe.LockedToPart = false
	if p.flipbook then
		pe.FlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4
		pe.FlipbookMode = Enum.ParticleFlipbookMode.OneShot
	end
	pe.Parent = parent
	return pe
end

local function pool(name: string): Pool?
	local existing = pools[name]
	if existing then
		return existing
	end
	local preset = PRESETS[name]
	if not preset then
		return nil
	end
	local att = Instance.new("Attachment")
	att.Name = "WorldMoments_" .. name
	att.Parent = workspace.Terrain
	local emitters = {}
	for _, p in preset do
		table.insert(emitters, makeEmitter(p, att))
	end
	local entry = { att = att, emitters = emitters, preset = preset }
	pools[name] = entry
	return entry
end

-- Emits a preset at `cf` (LookVector = spray direction); `scale` scales the particle counts.
local function burst(name: string, cf: CFrame, scale: number?)
	local entry = pool(name)
	if not entry then
		return
	end
	entry.att.WorldCFrame = cf
	for i, pe in entry.emitters do
		pe:Emit(math.max(1, math.floor(entry.preset[i].count * (scale or 1) + 0.5)))
	end
end

-- The inhale: ash and embers drawn in from a 13-stud sphere to the nose. A Part hosts it because shaped emission
-- (sphere surface, inward) needs a part's volume; it is parked in place and only its emitters toggle.
local inhaleHost: Part? = nil
local inhaleEmitters: { ParticleEmitter } = {}
local function inhaleRig(): (Part, { ParticleEmitter })
	if inhaleHost and inhaleHost.Parent then
		return inhaleHost, inhaleEmitters
	end
	local p = Instance.new("Part")
	p.Name = "SneezeInhaleHost"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Transparency = 1
	p.Size = Vector3.new(26, 26, 26)
	p.Parent = host()
	local list = {}
	for _, spec in {
		{ t = "ember", size = ns({ { 0, 1.1 }, { 1, 0.3 } }), color = ColorSequence.new(rgb(255, 214, 140), EMBER), light = 1, rate = 46 },
		{ t = "smoke_puff_4x4", size = ns({ { 0, 3.5 }, { 1, 1 } }), color = ColorSequence.new(rgb(120, 110, 104)), light = 0, rate = 16 },
	} do
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = tex(spec.t)
		pe.Enabled = false
		pe.Rate = spec.rate
		pe.Shape = Enum.ParticleEmitterShape.Sphere
		pe.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
		pe.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		pe.Lifetime = NumberRange.new(0.72, 0.8)
		pe.Speed = NumberRange.new(16, 17)
		pe.Size = spec.size
		pe.Transparency = ns({ { 0, 1 }, { 0.25, 0.2 }, { 0.85, 0.3 }, { 1, 1 } })
		pe.Color = spec.color
		pe.LightEmission = spec.light
		pe.LightInfluence = 1 - spec.light
		pe.Rotation = NumberRange.new(0, 360)
		pe.LockedToPart = false
		pe.Parent = p
		table.insert(list, pe)
	end
	inhaleHost = p
	inhaleEmitters = list
	return p, list
end

