local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local RaceAttr = require(Shared:WaitForChild("RaceAttr"))
local Rules = require(Shared:WaitForChild("WorldMomentsRules"))
local VfxAssets = require(Shared:WaitForChild("VfxAssets"))
local TrackRegistry = require(Shared:WaitForChild("TrackRegistry"))
local Vfx = require(script.Parent:WaitForChild("Vfx"))
local TrackFlow = require(script.Parent:WaitForChild("TrackFlow"))
local FlightController = require(script.Parent:WaitForChild("FlightController"))
local CarController = require(script.Parent:WaitForChild("CarController"))

local AUDIO: { [string]: string } = (function(): { [string]: string }
	local mod = Shared:FindFirstChild("WorldMomentsAudio")
	if mod and mod:IsA("ModuleScript") then
		local ok, res = pcall(require, mod)
		if ok and type(res) == "table" then
			return res :: any
		end
	end
	return {}
end)()

local LocalPlayer = Players.LocalPlayer

local WorldMoments = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end
local CREAM = rgb(255, 244, 214)
local INK = rgb(40, 26, 18)
local GOLD = rgb(255, 214, 90)
local EMBER = rgb(255, 150, 60)
local SOOT = rgb(34, 28, 26)

local folder: Folder? = nil
local function host(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "SkyRallyWorldMoments"
	f.Parent = workspace
	folder = f
	return f
end

local function tex(name: string): string
	local e = (VfxAssets :: any)[name]
	return if e then e.id else ""
end

local function ns(points: { { number } }): NumberSequence
	local kps = {}
	for _, p in points do
		table.insert(kps, NumberSequenceKeypoint.new(p[1], p[2]))
	end
	return NumberSequence.new(kps)
end

local function vehicleOf(userId: number): Model?
	local planes = workspace:FindFirstChild("Planes")
	if not planes then
		return nil
	end
	for _, m in planes:GetChildren() do
		if m:IsA("Model") and m:GetAttribute("OwnerUserId") == userId then
			return m
		end
	end
	return nil
end

local function hullOf(model: Model): BasePart?
	local h = model.PrimaryPart or model:FindFirstChild("Hull")
	return if h and h:IsA("BasePart") then h else nil
end

-- Where this client "is" for distance checks: its own vehicle, else the camera.
local function focus(): Vector3
	local model = vehicleOf(LocalPlayer.UserId)
	local hull = model and hullOf(model)
	if hull then
		return hull.Position
	end
	local cam = workspace.CurrentCamera
	return if cam then cam.CFrame.Position else Vector3.zero
end

-- Camera trauma on whichever controller drives this client's camera (both are camera-only: the hull never moves).
local function addTrauma(amount: number)
	if amount <= 0 then
		return
	end
	local model = vehicleOf(LocalPlayer.UserId)
	if not model then
		return
	end
	if model:GetAttribute("IsCar") == true then
		CarController.addTrauma(amount)
	else
		FlightController.addTrauma(amount)
	end
end

---------------------------------------------------------------------------------------------------- animation loop

type Anim = { t0: number, dur: number, step: (k: number, t: number) -> (), done: (() -> ())? }
local anims: { Anim } = {}
local loopConn: RBXScriptConnection? = nil

local function report(err: any)
	warn("[SkyRally][MOMENTS] " .. tostring(err))
end

-- A failing step ends its animation (and runs its cleanup) instead of erroring every frame.
local function stepAnims()
	local now = os.clock()
	for i = #anims, 1, -1 do
		local a = anims[i]
		local t = now - a.t0
		local last = t >= a.dur
		local ok = xpcall(a.step, report, if last then 1 else t / a.dur, if last then a.dur else t)
		if last or not ok then
			table.remove(anims, i)
			local done = a.done
			if done then
				xpcall(done, report)
			end
		end
	end
	if #anims == 0 and loopConn then
		loopConn:Disconnect()
		loopConn = nil
	end
end

local function animate(dur: number, step: (k: number, t: number) -> (), done: (() -> ())?)
	table.insert(anims, { t0 = os.clock(), dur = dur, step = step, done = done })
	if not loopConn then
		loopConn = RunService.Heartbeat:Connect(stepAnims)
	end
end

local function easeOutBack(x: number): number
	local c1, c3 = 1.70158, 2.70158
	local t = x - 1
	return 1 + c3 * t * t * t + c1 * t * t
end

---------------------------------------------------------------------------------------------------- sounds (pooled)

type SoundSlot = { att: Attachment, sound: Sound }
local soundSlots: { [string]: SoundSlot } = {}

-- Plays `cue` as a 3D sound at `pos` from the slot `key` (one Sound per key, restarted on reuse).
local function sfx(key: string, cue: string, pos: Vector3, volume: number, speed: number, maxDist: number)
	local id = AUDIO[cue]
	if not id then
		return
	end
	local slot = soundSlots[key]
	if not slot then
		local att = Instance.new("Attachment")
		att.Name = "WorldMomentsSound_" .. key
		att.Parent = workspace.Terrain
		local s = Instance.new("Sound")
		s.Name = key
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = 25
		s.Parent = att
		slot = { att = att, sound = s }
		soundSlots[key] = slot
	end
	local s = slot.sound
	slot.att.WorldPosition = pos
	if s.SoundId ~= id then
		s.SoundId = id
	end
	s.Volume = volume
	s.PlaybackSpeed = speed
	s.RollOffMaxDistance = maxDist
	s.TimePosition = 0
	s:Play()
end

