-- 2. Finish jingles

local function onFinish(rank: any, total: any)
	local go = RaceAttr.mine("RaceGoTime")
	local key = if type(go) == "number" then go else os.clock()
	if finishFor == key then
		return
	end
	finishFor = key
	local cue = MusicRules.finishCue(rank, total, RaceAttr.mine("RaceMode"))
	if not cue then
		return
	end
	finishToken += 1
	local token = finishToken
	setDuck("finish", 0.12, 0.6)
	local s = Music.oneShot(cue, 0.8)
	local length = if s and s.TimeLength > 0 then s.TimeLength else 12
	afterCue(s, length + 1, function()
		task.delay(if s then 1 else 0, function()
			if token == finishToken then
				setDuck("finish", nil, 0.8)
			end
		end)
	end)
end

------------------------------------------------------------------------------------------------------------------------
-- 3. Final lap surge

function Music.finalLap()
	surgeToken += 1
	local token = surgeToken
	setDuck("sting", 0.12, 0.15)
	Music.oneShot("jingle_finallap", 0.85)
	task.delay(STING_UNDUCK, function()
		if token ~= surgeToken then
			return
		end
		setDuck("sting", nil, 0.5)
		local mode = RaceAttr.mine("RaceMode")
		setSpeed(MusicRules.finalLapSpeed(MusicRules.themeSpeed(mode), mode), SURGE_RAMP)
	end)
end

local function onLap()
	local lap = LocalPlayer:GetAttribute("Lap")
	local prev = lastLap
	lastLap = lap
	local total = MusicRules.totalLaps(RaceAttr.mine("TotalLaps"), PlaneConfig.TOTAL_LAPS)
	if not MusicRules.isFinalLapEntry(prev, lap, total, RaceAttr.mine("RaceMode"), LocalPlayer:GetAttribute("RaceFinished")) then
		return
	end
	local go = RaceAttr.mine("RaceGoTime")
	if type(go) == "number" and surgeFor == go then
		return
	end
	surgeFor = if type(go) == "number" then go else nil
	Music.finalLap()
end

