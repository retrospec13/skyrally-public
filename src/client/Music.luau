-- 9. Secret Stinger

local cartridge: { Instance } = {}
local wobble: Tween? = nil

local function cartridgeOff(clearTime: number)
	local fx = cartridge
	cartridge = {}
	if wobble then
		wobble:Cancel()
		wobble = nil
	end
	if #fx == 0 then
		return
	end
	-- The filter clears over clearTime, then the instances go (nothing left in SoundService afterwards).
	local info = TweenInfo.new(clearTime, Enum.EasingStyle.Sine)
	for _, e in fx do
		if e:IsA("DistortionSoundEffect") then
			TweenService:Create(e, info, { Level = 0 }):Play()
		elseif e:IsA("EqualizerSoundEffect") then
			TweenService:Create(e, info, { LowGain = 0, MidGain = 0, HighGain = 0 }):Play()
		elseif e:IsA("PitchShiftSoundEffect") then
			TweenService:Create(e, info, { Octave = 1 }):Play()
		end
	end
	task.delay(clearTime + 0.05, function()
		for _, e in fx do
			e:Destroy()
		end
	end)
end

local function cartridgeOn()
	local g = themeGroup
	if not g or #cartridge > 0 then
		return -- already filtered: a second find extends it, never stacks a second chain
	end
	local pitch = Instance.new("PitchShiftSoundEffect")
	pitch.Name = "SkyRallyCartridgePitch"
	pitch.Octave = 1
	pitch.Priority = 3
	pitch.Parent = g
	local dist = Instance.new("DistortionSoundEffect")
	dist.Name = "SkyRallyCartridgeCrunch"
	dist.Level = 0.32
	dist.Priority = 2
	dist.Parent = g
	local eq = Instance.new("EqualizerSoundEffect")
	eq.Name = "SkyRallyCartridgeBand"
	eq.LowGain = -12
	eq.MidGain = 2
	eq.HighGain = -9
	eq.Priority = 1
	eq.Parent = g
	cartridge = { pitch, dist, eq }
	-- A worn cartridge's wobble: 1.0 -> 0.98 octave and back every 0.25 s.
	local tw = TweenService:Create(pitch, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Octave = 0.98 })
	wobble = tw
	tw:Play()
end

function Music.secret(kind: string)
	secretToken += 1
	local token = secretToken
	local theme = current
	setDuck("secret", 0, 0.12)
	task.delay(0.12, function()
		-- ducks.secret is cleared when the fanfare ends (at once when the chip cue has no id): never pause after that.
		if token == secretToken and ducks.secret == 0 and theme and current == theme and theme.IsPlaying then
			theme:Pause() -- a real pause: the theme picks up where it left off
		end
	end)
	local s = Music.oneShot(MusicRules.secretCue(kind), 0.8)
	afterCue(s, if kind == "key" then 5 else 2.5, function()
		if token ~= secretToken then
			return
		end
		local now = current
		if now and now.IsPaused then
			now:Resume()
		end
		cartridgeOn()
		setDuck("secret", nil, 0.35)
		task.delay(SECRET_FILTER_S - 1, function()
			if token == secretToken then
				cartridgeOff(1)
			end
		end)
	end)
end

------------------------------------------------------------------------------------------------------------------------
-- 26. The last-10-seconds clock and the air horn

local CLOCK_VOLUME = 0.6
local CLOCK_LAST_VOLUME = 0.8
local HORN_VOLUME = 0.95
local TAPE_RESTORE = 1.8 -- the horn owns the moment this long, then the map's theme returns

local sfxSounds: { [string]: Sound } = {}
local clockKey: number? = nil -- the deadline the clock counts to
local clockPrev: number? = nil
local clockOn = false -- the clock's duck and tempo are applied
local hornedFor: number? = nil
local liveFor: number? = nil -- the deadline this client saw running (joining during a battle's results: no horn)
local tapeToken = 0

-- A sound effect cue (the clock, the horn): pooled one per cue like the music cues, but outside the music group and
-- not scaled by MusicVolume.
local function sfx(cue: string, volume: number)
	local s: Sound? = sfxSounds[cue]
	if not s or not s.Parent then
		s = makeSound(cue, false, nil)
		if not s then
			logMissing(cue)
			return
		end
		sfxSounds[cue] = s
	end
	local snd = s :: Sound
	snd:Stop()
	snd.TimePosition = 0
	snd.Volume = volume
	snd:Play()
end

local function clockOff()
	if clockOn then
		clockOn = false
		setDuck("clock", nil, 0.5)
		setSpeed(MusicRules.themeSpeed(RaceAttr.mine("RaceMode")), 0.6)
	end
end

-- The theme winds down like a stopped tape (pitch and level fall together), then the map's theme comes back.
local function tapeStop()
	tapeToken += 1
	local token = tapeToken
	local s = current
	putDuck("tape", 0)
	if s then
		if volumeTween then
			volumeTween:Cancel()
		end
		if speedTween then
			speedTween:Cancel()
		end
		local info = TweenInfo.new(SoundscapeRules.TAPE_STOP, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		local vt = TweenService:Create(s, info, { Volume = 0 })
		local st = TweenService:Create(s, info, { PlaybackSpeed = s.PlaybackSpeed * SoundscapeRules.TAPE_STOP_SPEED })
		volumeTween = vt
		speedTween = st
		vt:Play()
		st:Play()
	end
	task.delay(TAPE_RESTORE, function()
		if token ~= tapeToken then
			return
		end
		putDuck("tape", nil)
		setSpeed(MusicRules.themeSpeed(RaceAttr.mine("RaceMode")), 0)
		zoneTheme() -- a finished battle's results get the map's own theme; the same cue just comes back up
		applyVolume(1.2)
	end)
end

local function horn(at: number)
	hornedFor = at
	clockOn = false
	putDuck("clock", nil)
	sfx("sfx_airhorn", HORN_VOLUME)
	tapeStop()
end

-- The deadline a clock runs to right now (server time), and its state: a running battle's cap, the hub's next Storm
-- Cup during the lobby minute, or the Studio QA clock.
local function clockDeadline(): (number?, string?)
	if workspace:GetAttribute("TrackSwitching") == true then
		return nil, nil
	end
	if RunService:IsStudio() then
		local qa = workspace:GetAttribute("QAClockAt")
		if type(qa) == "number" then
			return qa, "qa"
		end
	end
	local mode = RaceAttr.mine("RaceMode")
	if mode == "battle" then
		local st = RaceAttr.mine("BattleState")
		local at = RaceAttr.mine("BattleEndsAt")
		if type(at) == "number" and (st == "running" or st == "over") then
			return at, st
		end
	elseif mode == "hub" and workspace:GetAttribute("StormCupEnabled") == true then
		local st = workspace:GetAttribute("StormCupState")
		local at = workspace:GetAttribute("StormCupAt")
		if type(at) == "number" and (st == "lobby" or st == "due") then
			return at, st
		end
	end
	return nil, nil
end

local function stepClock()
	local at, st = clockDeadline()
	if at ~= clockKey then
		clockKey = at
		clockPrev = nil
		clockOff()
	end
	if not at then
		return
	end
	if st == "over" then
		-- The battle ended (at the cap, or early: the last survivor, every egg home): the buzzer once.
		if hornedFor ~= at and liveFor == at then
			horn(at)
		end
		clockOff()
		return
	end
	liveFor = at
	local left = at - workspace:GetServerTimeNow()
	local ev, s = SoundscapeRules.clockEvent(clockPrev, left)
	clockPrev = left
	if SoundscapeRules.clockActive(left) and not clockOn and hornedFor ~= at then
		clockOn = true
		setDuck("clock", SoundscapeRules.CLOCK_DUCK, 0.5)
		setSpeed(MusicRules.themeSpeed(RaceAttr.mine("RaceMode")) * SoundscapeRules.CLOCK_TEMPO, 1)
	end
	if ev == "tick" then
		local cue = SoundscapeRules.clockCue(s)
		if cue then
			sfx(cue, if cue == "clock_last" then CLOCK_LAST_VOLUME else CLOCK_VOLUME)
		end
	elseif ev == "horn" and hornedFor ~= at then
		horn(at)
	end
end

------------------------------------------------------------------------------------------------------------------------

local function onTrackSwitching()
	local on = workspace:GetAttribute("TrackSwitching") == true
	if on then
		tapeToken += 1 -- a horn's tape stop hands over to the curtain
		putDuck("tape", nil)
		putDuck("clock", nil)
		clockOn = false
		-- A new map: the boss chase and the final-lap tempo end here; the zone theme comes back under the curtain.
		bossLock = false
		surgeToken += 1
		putDuck("sting", nil)
		putDuck("roar", nil)
		introGoFor = nil
		for cue, s in prepared do
			prepared[cue] = nil
			s:Destroy() -- a chase theme loaded for a race that never reached GO
		end
		setSpeed(1, 0.6)
		zoneTheme()
	end
	setDuck("curtain", if on then 0.12 else nil, 0.6)
end

local function hookRaceEvents()
	local remotes = ReplicatedStorage:WaitForChild("SkyRallyRemotes", 15)
	local remote = if remotes then remotes:WaitForChild("RaceEventRemote", 10) else nil
	if remote and remote:IsA("RemoteEvent") then
		(remote :: RemoteEvent).OnClientEvent:Connect(function(eventType: string, payload: any)
			if eventType == "RaceFinished" and type(payload) == "table" then
				local total = if type(payload.standings) == "table" then #payload.standings else RaceAttr.mine("TotalRacers")
				onFinish(payload.rank, total)
			end
		end)
	else
		-- No race remote: the FinishRank attribute still drives the jingle (it misses a repeat of the same rank).
		LocalPlayer:GetAttributeChangedSignal("FinishRank"):Connect(function()
			onFinish(LocalPlayer:GetAttribute("FinishRank"), RaceAttr.mine("TotalRacers"))
		end)
	end
end

function Music.init()
	local ok, t = pcall(function()
		return require(Shared:WaitForChild("AudioAssets", 10) :: ModuleScript) :: any
	end)
	if not ok or type(t) ~= "table" then
		warn("[SkyRally][MUSIC] no AudioAssets; music off")
		return
	end
	assets = table.clone(t)
	-- Item 26: the Storm Cup and battle themes, the clock and the horn come from the soundscape upload
	-- (shared/SoundscapeAudio, generated by tools/vfx/upload_set.py; empty until uploaded: those cues stay silent).
	local okS, ts = pcall(function()
		return require(Shared:WaitForChild("SoundscapeAudio", 5) :: ModuleScript) :: any
	end)
	if okS and type(ts) == "table" then
		for cue, id in ts do
			if assets[cue] == nil then
				assets[cue] = id
			end
		end
	end
	-- sfx_v2: the new 3-2-1-GO (same 4.2 s timing: pips on 3, 2, 1, the GO stab at 0) replaces the first-pass jingle.
	local okV, tv = pcall(function()
		return require(Shared:WaitForChild("SfxV2Audio", 5) :: ModuleScript) :: any
	end)
	if okV and type(tv) == "table" and type(tv.countdown_v2) == "string" then
		assets.jingle_countdown = tv.countdown_v2
	end
	local g = Instance.new("SoundGroup")
	g.Name = "SkyRallyMusic"
	g.Volume = 1
	g.Parent = SoundService
	themeGroup = g
	local cg = Instance.new("SoundGroup")
	cg.Name = "SkyRallyCues"
	cg.Volume = 1
	cg.Parent = SoundService
	cueGroup = cg
	-- Preload the short cues that must land on time (stings, jingles, chip fanfares).
	for _, cue in { "jingle_countdown", "jingle_victory", "jingle_place2", "jingle_place3", "jingle_midpack", "jingle_last",
		"jingle_finallap", "chip_secret", "chip_find" } do
		if has(cue) then
			cueSound(cue)
		end
	end

	-- Item 26: the clock and the horn must land on the second, so their sounds load now.
	for _, cue in { "clock_tick", "clock_tock", "clock_last", "sfx_airhorn" } do
		if has(cue) then
			local s = makeSound(cue, false, nil)
			if s then
				sfxSounds[cue] = s
			end
		end
	end

	require(script.Parent.BossIntro).onIntro(Music.bossIntro)
	RaceAttr.changed("ActiveZone", zoneTheme)
	-- Item 26: RaceMode (a Storm Cup) and BattleKind arrive after ActiveZone under the curtain; a FLY AGAIN battle
	-- replay brings the battle theme back (BattleState leaves "over"; "over" itself is the horn's job in stepClock).
	RaceAttr.changed("RaceMode", zoneTheme)
	RaceAttr.changed("BattleKind", zoneTheme)
	RaceAttr.changed("BattleState", function()
		if RaceAttr.mine("BattleState") ~= "over" then
			zoneTheme()
		end
	end)
	workspace:GetAttributeChangedSignal("TrackSwitching"):Connect(onTrackSwitching)
	if workspace:GetAttribute("TrackSwitching") == true then
		putDuck("curtain", 0.12) -- joined under the curtain
	end
	LocalPlayer:GetAttributeChangedSignal("MusicVolume"):Connect(function()
		applyVolume(0.6)
	end)
	lastLap = LocalPlayer:GetAttribute("Lap")
	LocalPlayer:GetAttributeChangedSignal("Lap"):Connect(onLap)
	task.spawn(hookRaceEvents)
	RunService.Heartbeat:Connect(Prof.wrap("SR_Music", function()
		stepClock() -- item 26: battles and the hub's Storm Cup lobby run with or without a RaceGoTime
		local go = RaceAttr.mine("RaceGoTime")
		if type(go) ~= "number" then
			if ducks.roar then
				clearRoarSilence()
			end
			return
		end
		if ducks.roar and introGoFor ~= go then
			clearRoarSilence() -- the race the roar silenced was called off: the theme comes back
		end
		if workspace:GetAttribute("TrackSwitching") == true then
			return -- RaceMode changes under the curtain while RaceGoTime still holds the old race's GO
		end
		if go ~= tempoGoFor then
			-- A new race on the same map (FLY AGAIN replays without a TrackSwitching): drop the last race's final-lap
			-- surge. Boss modes set their own tempo when the chase theme restarts on GO.
			tempoGoFor = go
			local mode = RaceAttr.mine("RaceMode")
			local s = current
			if s and not MusicRules.isBossMode(mode) and s.PlaybackSpeed ~= 1 then
				surgeToken += 1
				if ducks.sting then
					setDuck("sting", nil, 0.5)
				end
				setSpeed(1, 0.6)
			end
		end
		local left = go - workspace:GetServerTimeNow()
		if go ~= countdownPlayedFor and left <= 3.02 and left > 2.6 then
			countdownPlayedFor = go
			Music.oneShot("jingle_countdown", COUNTDOWN_VOLUME)
		end
		if go ~= bossGoFor then
			local mode = RaceAttr.mine("RaceMode")
			if MusicRules.isBossMode(mode) then
				if left > 0 then
					if preparedFor ~= go then
						prepareBoss(go)
					end
				else
					startBossTheme(go, mode)
				end
			end
		end
	end))
	zoneTheme()
	print(string.format("[SkyRally][MUSIC] ready cues=%d", (function()
		local n = 0
		for _ in assets do
			n += 1
		end
		return n
	end)()))
end

return Music
