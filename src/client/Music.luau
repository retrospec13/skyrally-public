--!strict
-- Zone music (PLAN L24): one looped theme per zone (shared/AudioAssets, generated by tools/vfx/upload_set.py from
-- assets/audio/music_v1; original Higgsfield sonilo cues and code-synthesised cues, licences in ASSETS section 7),
-- crossfaded when workspace.ActiveZone changes, ducked under the track-switch curtain, a countdown cue before GO.
-- Client-only Sounds under SoundService play for this player alone. Volume persists per session (MusicVolume player
-- attribute, 0..1) so a settings toggle can drive it.
--
-- REMARKABLE Batch 1 (decisions in shared/MusicRules, pinned by tools/tests/music_spec.luau):
--   1. Boss intro: at BossAnimator.ROAR_DELAY into the sweep the theme is cut to silence in 0.15 s (still playing, so
--      an aborted race brings it back), the boss roars from its own body (3D, roar_<clips>) and the camera takes a
--      punch; two beats of silence, the 3-2-1, and on GO the boss chase theme slams in (0.2 s; 4 % faster in a
--      rematch). It owns the music until the next TrackSwitching.
--   2. Finish jingle for every place (RaceFinished): victory, runner-up, bronze, a good-try for the pack and the
--      wah-wah trombone for last of four or more; the theme ducks for the cue's length + 1 s.
--   3. Final lap surge: on the Lap change into the last lap, a brass-and-snare sting, then the theme speeds up about
--      6 % (8 % in boss races) until the next theme change or TrackSwitching.
--   9. Secret Stinger (Music.secret, from TrackFlow KeyFound / HubFind): the theme pauses for an original 8-bit
--      fanfare, then comes back for 6 s through an "old cartridge" filter on the theme SoundGroup (crunch, narrow
--      band, a detuned wobble) that clears before the instances are removed.
-- REMARKABLE Batch 2 item 26 (decisions in shared/SoundscapeRules, pinned by tools/tests/soundscape_spec.luau):
--   Storm Cup and battle themes: a Storm Cup race plays music_stormcup, a running battle its kind's theme
--      (music_battle_survival / egg / water / hoard); each falls back to the zone theme while it has no id.
--   The last-10-seconds clock: in a battle's last ten seconds (BattleEndsAt) and the hub's last ten before a Storm Cup
--      (StormCupAt, lobby), a wooden clock ticks and tocks each second (the last three hard, with a ping), the theme
--      steps back and pushes 5 % faster; at zero an air horn blasts, the theme winds down like a stopped tape, and
--      1.8 s later the map's own theme comes back (a battle's results) or the curtain takes over (the cup).
--      Studio QA: workspace.QAClockAt = <server time> runs the same clock to that moment anywhere.
-- Sounds: themes in SoundService.SkyRallyMusic (the cartridge filter lives there), cues pooled one per cue in
-- SoundService.SkyRallyCues (a retrigger restarts, never stacks). The clock and the horn are sound effects, pooled the
-- same way outside the music group (the music slider does not mute them). A missing id is silent: one log line per cue.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Prof = require(Shared:WaitForChild("Prof")) -- MicroProfiler labels (perf review v21 PF-10)
local RaceAttr = require(Shared:WaitForChild("RaceAttr"))
local MusicRules = require(Shared:WaitForChild("MusicRules"))
local SoundscapeRules = require(Shared:WaitForChild("SoundscapeRules"))
local BossConfig = require(Shared:WaitForChild("BossConfig"))
local PlaneConfig = require(Shared:WaitForChild("PlaneConfig"))
local Settings = require(script.Parent:WaitForChild("Settings")) -- audit H13: camera shake toggle

local LocalPlayer = Players.LocalPlayer

local Music = {}

local BASE_VOLUME = 0.42
local FADE = 1.6
local ROAR_DELAY = 0.45 -- fallback when BossAnimator does not export ROAR_DELAY
local ROAR_CUT = 0.15 -- the theme's hard fade under the roar
local BOSS_SLAM = 0.2 -- the boss theme's fade-in on GO
local PUNCH = 0.35 -- camera punch on the roar
local STING_UNDUCK = 1.6 -- the final-lap sting owns the mix this long, then the tempo rises
local SURGE_RAMP = 0.8
local SECRET_FILTER_S = 6
local COUNTDOWN_VOLUME = 0.94 -- the sfx_v2 countdown (upload_list.json volume); the old jingle played at 0.75

local assets: { [string]: string } = {}
local themeGroup: SoundGroup? = nil
local cueGroup: SoundGroup? = nil
local current: Sound? = nil
local currentCue = ""
local prepared: { [string]: Sound } = {} -- themes loaded ahead of GO (boss chase), not playing yet
local cueSounds: { [string]: Sound } = {}
local ducks: { [string]: number } = {}
local volumeTween: Tween? = nil
local speedTween: Tween? = nil
local logged: { [string]: boolean } = {}

local countdownPlayedFor: number? = nil
local bossLock = false -- the boss chase theme owns the music until the next TrackSwitching
local bossGoFor: number? = nil
local preparedFor: number? = nil
local introGoFor: number? = nil
local finishFor: number? = nil
local surgeFor: number? = nil
local surgeToken = 0
local tempoGoFor: number? = nil -- the RaceGoTime the theme tempo belongs to (a FLY AGAIN replay has no TrackSwitching)
local finishToken = 0
local secretToken = 0
local lastLap: any = nil

local function volumeScale(): number
	local v = LocalPlayer:GetAttribute("MusicVolume")
	return if type(v) == "number" then math.clamp(v, 0, 1) else 1
end

local function logMissing(cue: string)
	if not logged[cue] then
		logged[cue] = true
		print("[SkyRally][MUSIC] no asset for " .. cue .. " (silent)")
	end
end

local function has(cue: string): boolean
	return assets[cue] ~= nil
end

local function makeSound(cue: string, looped: boolean, g: SoundGroup?): Sound?
	local id = assets[cue]
	if not id then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = "SkyRally_" .. cue
	s.SoundId = id
	s.Looped = looped
	s.Volume = 0
	s.SoundGroup = g
	s.Parent = SoundService
	return s
end

local function fadeTo(s: Sound, vol: number, t: number, thenStop: boolean?)
	local tw = TweenService:Create(s, TweenInfo.new(t, Enum.EasingStyle.Sine), { Volume = vol })
	if thenStop then
		tw.Completed:Connect(function()
			s:Stop()
			s:Destroy()
		end)
	end
	tw:Play()
end

local function targetVolume(): number
	return BASE_VOLUME * volumeScale() * MusicRules.duckFactor(ducks)
end

-- Move the current theme to the volume the active ducks allow.
local function applyVolume(t: number)
	local s = current
	if not s then
		return
	end
	if volumeTween then
		volumeTween:Cancel()
	end
	local tw = TweenService:Create(s, TweenInfo.new(t, Enum.EasingStyle.Sine), { Volume = targetVolume() })
	volumeTween = tw
	tw:Play()
end

local function putDuck(reason: string, factor: number?)
	(ducks :: any)[reason] = factor
end

local function setDuck(reason: string, factor: number?, t: number)
	putDuck(reason, factor)
	applyVolume(t)
end

local function setSpeed(speed: number, t: number)
	if speedTween then
		speedTween:Cancel()
		speedTween = nil
	end
	local s = current
	if not s then
		return
	end
	if t <= 0 then
		s.PlaybackSpeed = speed
		return
	end
	local tw = TweenService:Create(s, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { PlaybackSpeed = speed })
	speedTween = tw
	tw:Play()
end

-- Loop a theme: crossfade from the old one (fade seconds, default 1.6) at PlaybackSpeed speed (default 1).
function Music.playTheme(cue: string, fade: number?, speed: number?)
	local t = fade or FADE
	local spd = speed or 1
	if cue == currentCue and current then
		setSpeed(spd, 0)
		applyVolume(t)
		return
	end
	local old = current
	currentCue = cue
	local s: Sound? = prepared[cue]
	prepared[cue] = nil
	if not s then
		s = makeSound(cue, true, themeGroup)
	end
	current = s
	volumeTween = nil
	if speedTween then
		speedTween:Cancel()
		speedTween = nil
	end
	if old then
		fadeTo(old, 0, t, true)
	end
	if s then
		s.PlaybackSpeed = spd
		s.Volume = 0
		s:Play()
		applyVolume(t)
	else
		logMissing(cue)
	end
end

local function zoneTheme()
	if bossLock then
		return
	end
	-- Item 26: the Storm Cup theme, a running battle's theme, else the zone theme (the first one with an id).
	local candidates = SoundscapeRules.themeCandidates(MusicRules.zoneTheme(RaceAttr.mine("ActiveZone")),
		RaceAttr.mine("RaceMode"), RaceAttr.mine("BattleKind"), RaceAttr.mine("BattleState"))
	local cue = MusicRules.pick(candidates, has) or candidates[#candidates]
	if cue then
		Music.playTheme(cue)
	end
end

-- One pooled Sound per cue (created on first use, kept): a retrigger restarts the cue instead of stacking it.
local function cueSound(cue: string): Sound?
	local s: Sound? = cueSounds[cue]
	if s and s.Parent then
		return s
	end
	s = makeSound(cue, false, cueGroup)
	if not s then
		logMissing(cue)
		return nil
	end
	cueSounds[cue] = s
	return s
end

function Music.oneShot(cue: string, volume: number?): Sound?
	local s = cueSound(cue)
	if not s then
		return nil
	end
	s:Stop()
	s.TimePosition = 0
	s.Volume = (volume or 0.7) * volumeScale()
	s:Play()
	return s
end

-- Run fn once the cue finishes (its Ended), or after fallback seconds if it never loads or plays.
local function afterCue(s: Sound?, fallback: number, fn: () -> ())
	local done = false
	local function finish()
		if not done then
			done = true
			fn()
		end
	end
	if s then
		s.Ended:Once(finish)
	end
	task.delay(if s then fallback else 0, finish)
end

------------------------------------------------------------------------------------------------------------------------
-- 1. Boss intro: roar, silence, chase theme on GO

local punchStart = 0
local punchAmp = 0
local punchBound = false
local lastWritten: CFrame? = nil
local lastShake: CFrame? = nil

-- Camera punch that rides on whatever owns the camera (the intro sweep binds at RenderPriority.Last; this runs right
-- after it). A frame nobody else rewrote has the previous shake removed first, so it never drifts.
local function cameraPunch(amount: number)
	punchStart = os.clock()
	punchAmp = amount
	if punchBound then
		return
	end
	punchBound = true
	lastWritten = nil
	RunService:BindToRenderStep("SkyRallyMusicPunch", Enum.RenderPriority.Last.Value + 1, function()
		local cam = workspace.CurrentCamera
		local t = os.clock() - punchStart
		local k = punchAmp * math.max(0, 1 - t / 0.8)
		if not cam or k <= 0 then
			RunService:UnbindFromRenderStep("SkyRallyMusicPunch")
			punchBound = false
			return
		end
		local base = cam.CFrame
		if lastWritten and lastShake and base == lastWritten then
			base *= lastShake:Inverse()
		end
		local s = k * k * 4 * Settings.shakeScale() -- trauma squared, as the vehicle cameras do; 0 with camera shake off
		local shake = CFrame.new(1.6 * s * math.sin(t * 47), 1.2 * s * math.sin(t * 61), 0)
			* CFrame.Angles(0.02 * s * math.sin(t * 53), 0, 0.06 * s * math.sin(t * 37))
		local out = base * shake
		cam.CFrame = out
		lastWritten = out
		lastShake = shake
	end)
end

local function roarDelay(): number
	local ok, ba = pcall(function()
		return require(script.Parent.BossAnimator) :: any
	end)
	local d = if ok and type(ba) == "table" then ba.ROAR_DELAY else nil
	return if type(d) == "number" then d else ROAR_DELAY
end

local function bossZone(model: Model?): string?
	local z = if model then model:GetAttribute("BossZone") else nil
	if type(z) ~= "string" then
		z = RaceAttr.mine("ActiveZone")
	end
	return if type(z) == "string" then z else nil
end

-- Load the chase theme and the roar while the grid holds, so both start on time.
local function prepareBoss(go: number)
	preparedFor = go
	local zone = bossZone(nil)
	local cue = MusicRules.pick(MusicRules.bossThemeCandidates(zone), has)
	if cue and cue ~= currentCue and not prepared[cue] then
		local s = makeSound(cue, true, themeGroup)
		if s then
			prepared[cue] = s
		end
	end
	local boss = BossConfig.forZone(zone)
	local roar = MusicRules.roarCue(boss and boss.clips)
	if roar and has(roar) then
		cueSound(roar)
	end
end

local function clearRoarSilence()
	if ducks.roar then
		setDuck("roar", nil, 0.6)
	end
	introGoFor = nil
end

local function startBossTheme(go: number, mode: any)
	bossGoFor = go
	bossLock = true
	putDuck("roar", nil)
	introGoFor = nil
	local zone = bossZone(nil)
	local cue = MusicRules.pick(MusicRules.bossThemeCandidates(zone), has)
	if not cue then
		bossLock = false
		applyVolume(0.6)
		return
	end
	-- Only a chase theme restarts; a zone theme standing in for a missing one just carries on.
	local restart = cue == currentCue and current ~= nil and string.sub(cue, 1, 11) == "music_boss_"
	Music.playTheme(cue, BOSS_SLAM, MusicRules.themeSpeed(mode))
	local s = current
	if restart and s then
		s.TimePosition = 0 -- a rematch on the same track: the chase starts over on GO
	end
end

-- BossIntro.onIntro listener: the sweep has started on model and lasts sweep seconds.
function Music.bossIntro(model: Model, _sweep: number)
	local go = RaceAttr.mine("RaceGoTime")
	if type(go) ~= "number" then
		return
	end
	introGoFor = go
	local boss = BossConfig.forZone(bossZone(model))
	local roar = MusicRules.roarCue(boss and boss.clips)
	task.delay(roarDelay(), function()
		if introGoFor ~= go or RaceAttr.mine("RaceGoTime") ~= go then
			return -- aborted before the roar
		end
		setDuck("roar", 0, ROAR_CUT)
		cameraPunch(PUNCH)
		local s = if roar then cueSound(roar) else nil
		if not s then
			return
		end
		local hull = model.PrimaryPart
		s:Stop()
		s.TimePosition = 0
		s.SoundGroup = nil -- a sound effect, not music: the music slider does not mute the boss
		s.Volume = 1
		if hull and hull.Parent then
			s.RollOffMode = Enum.RollOffMode.InverseTapered
			s.RollOffMinDistance = 90 -- the intro camera orbits about 70 studs out: full voice there and on the grid
			s.RollOffMaxDistance = 600
			s.Parent = hull
		end
		s:Play()
		afterCue(s, 6, function()
			-- Back to the pool when the boss model goes away with the race. If the boss was destroyed mid-roar the
			-- Sound went with it (Parent locked): pcall keeps that silent, and cueSound makes a fresh one next time.
			if s.Parent ~= SoundService then
				pcall(function()
					s.Parent = SoundService
				end)
			end
		end)
	end)
end

