--!strict
-- SPACE-4 neon pass (Star City), client only: giant holographic blocky figures that stand beside the track and lean over
-- it, and holo billboards with animated copy. Placements come from shared/SpaceNeonLayout (generated by
-- tools/map/author_space4.py, checked against the road by shared/SpaceNeonRules.clearOfRoad); the pose, flicker and copy
-- are pure functions of server time (shared/SpaceNeonRules), so every client sees the same figures doing the same thing.
-- * VISUAL ONLY: every part is Anchored, CanCollide/CanQuery/CanTouch false, CastShadow false; nothing here is a map
--   Instance, so wall and mountain driving, the corridor, kill volumes and rescue are untouched.
-- * Phone budget: 18 parts per figure (5 figures), 1 part + 1 SurfaceGui per billboard, one 4 Hz-capped updater. Poses are
--   written with BulkMoveTo, nearest figures first at up to 30 Hz, thinning to 6 Hz and frozen beyond 1800 studs (and
--   when a far figure is behind the camera); text and colours are written only when they change. Highlights (the rim)
--   (removed in v29) and the scanline emitters are off under LOW GRAPHICS and on the phone tier's emitters scale with Settings.
-- * The head turns toward the local racer (MomentKit.focus: the kart, else the camera).
-- QA (Studio): workspace.SpaceNeonTest = true prints the figure and board counts; workspace.SpaceNeonHide = true removes them.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local RaceAttr = require(Shared:WaitForChild("RaceAttr"))
local Rules = require(Shared:WaitForChild("SpaceNeonRules"))
local Layout = require(Shared:WaitForChild("SpaceNeonLayout"))
local Settings = require(script.Parent:WaitForChild("Settings"))
local Kit = require(script.Parent:WaitForChild("MomentKit"))
local ToolboxCues = require(script.Parent:WaitForChild("ToolboxCues"))
local AudioRules = require(Shared:WaitForChild("ToolboxAudioRules"))

local SpaceNeon = {}

-- v29 W1b A8 (critic v29: the figures read as a solid magenta glass building over the road): faint Glass bodies at 0.8,
-- no Highlight rim, no Neon pad disc; only the face stays an emissive Neon accent. Placement (behind the first tower row,
-- 60 studs tall at most, st. 560 and 4450 figures gone) comes from tools/map/author_space4.py -> SpaceNeonLayout.
local BODY_TRANSPARENCY = 0.8
local BODY_MATERIAL = Enum.Material.Glass
local FACE_TRANSPARENCY = 0.35
local FOLDER_NAME = "SpaceNeonHolo"
local PARTICLE_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"

type Figure = {
	model: Model,
	parts: { BasePart },
	cfs: { CFrame }, -- scratch for BulkMoveTo
	base: CFrame,
	height: number,
	lean: number,
	phase: number,
	faceYaw: number,
	pos: Vector3,
	emitter: ParticleEmitter?,
	baseRate: number,
	nextAt: number,
	headYaw: number,
	lastTransparency: number,
}

type Board = {
	part: Part,
	title: TextLabel,
	sub: TextLabel,
	bar: Frame,
	stroke: UIStroke,
	index: number,
	pos: Vector3,
	palette: number,
	lastCopy: number,
	lastText: string,
	lastGlitch: boolean,
	nextAt: number,
}

local folder: Folder? = nil
local figures: { Figure } = {}
local boards: { Board } = {}
local conn: RBXScriptConnection? = nil
local token = 0

local function visualOnly(p: BasePart)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
end

local function buildFigure(parent: Instance, i: number, d: any): Figure
	local look = Rules.LOOKS[d.palette + 1] or Rules.LOOKS[1]
	local k = d.height / Rules.UNIT_HEIGHT
	local model = Instance.new("Model")
	model.Name = "HoloFigure_" .. tostring(i)
	local parts: { BasePart } = {}
	for j, name in Rules.PART_NAMES do
		local sz = Rules.PART_SIZES[j]
		local p = Instance.new("Part")
		p.Name = name
		p.Size = Vector3.new(sz[1] * k, sz[2] * k, sz[3] * k)
		local face = Rules.ACCENT_PARTS[name] == true
		p.Material = if face then Enum.Material.Neon else BODY_MATERIAL
		p.Color = if face then look.accent else look.body
		p.Transparency = if face then FACE_TRANSPARENCY else BODY_TRANSPARENCY
		visualOnly(p)
		p.Parent = model
		parts[j] = p
	end
	local base = CFrame.new(d.pos) * CFrame.Angles(0, math.rad(d.yaw), 0)
	-- v29 A8: no projector pad disc and no Highlight rim (both read as solid neon at range).
	-- scanlines: slow rising specks from the chest (a few per second; scaled with Settings.particleScale)
	local chest = parts[2]
	local em = Instance.new("ParticleEmitter")
	em.Texture = PARTICLE_TEXTURE
	em.Color = ColorSequence.new(look.accent, look.body)
	em.LightEmission = 1
	em.Lifetime = NumberRange.new(2.4, 3.6)
	em.Speed = NumberRange.new(3, 7)
	em.SpreadAngle = Vector2.new(10, 180)
	em.EmissionDirection = Enum.NormalId.Top
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.2, d.height * 0.03), NumberSequenceKeypoint.new(1, 0) })
	em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	em.Rate = 0
	em.Rotation = NumberRange.new(0, 360)
	em.Parent = chest
	model.Parent = parent
	local fig: Figure = {
		model = model,
		parts = parts,
		cfs = table.create(#parts, CFrame.identity),
		base = base,
		height = d.height,
		lean = d.lean,
		phase = d.phase,
		faceYaw = d.yaw,
		pos = d.pos,
		emitter = em,
		baseRate = 3, -- v29 A8: was 6
		nextAt = 0,
		headYaw = 0,
		lastTransparency = -1,
	}
	return fig
end

local function buildBoard(parent: Instance, i: number, d: any): Board
	local look = Rules.LOOKS[d.palette + 1] or Rules.LOOKS[1]
	local part = Instance.new("Part")
	part.Name = "HoloBillboard_" .. tostring(i)
	part.Size = Vector3.new(d.width, d.height, 0.6)
	part.CFrame = CFrame.new(d.pos) * CFrame.Angles(0, math.rad(d.yaw), 0)
	part.Material = Enum.Material.Glass
	part.Color = Color3.fromRGB(14, 10, 40)
	part.Transparency = 0.3
	visualOnly(part)
	part.Parent = parent
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 10
	gui.LightInfluence = 0
	gui.Brightness = 2
	gui.AlwaysOnTop = false
	gui.ClipsDescendants = true
	gui.Adornee = part
	gui.Parent = part
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(14, 10, 40)
	bg.BackgroundTransparency = 0.25
	bg.BorderSizePixel = 0
	bg.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 6
	stroke.Color = look.body
	stroke.Parent = bg
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromScale(0.04, 0.12)
	title.Size = UDim2.fromScale(0.92, 0.52)
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.TextColor3 = look.accent
	title.Text = ""
	title.Parent = bg
	local sub = Instance.new("TextLabel")
	sub.BackgroundTransparency = 1
	sub.Position = UDim2.fromScale(0.04, 0.66)
	sub.Size = UDim2.fromScale(0.92, 0.2)
	sub.Font = Enum.Font.GothamBold
	sub.TextScaled = true
	sub.TextColor3 = look.body
	sub.Text = ""
	sub.Parent = bg
	local bar = Instance.new("Frame")
	bar.Size = UDim2.fromScale(1, 0.04)
	bar.BackgroundColor3 = Color3.new(1, 1, 1)
	bar.BackgroundTransparency = 0.82
	bar.BorderSizePixel = 0
	bar.Parent = bg
	return {
		part = part,
		title = title,
		sub = sub,
		bar = bar,
		stroke = stroke,
		index = i - 1,
		pos = d.pos,
		palette = d.palette,
		lastCopy = 0,
		lastText = "",
		lastGlitch = false,
		nextAt = 0,
	}
end

local function stop()
	token += 1
	if conn then
		conn:Disconnect()
		conn = nil
	end
	if folder then
		folder:Destroy()
		folder = nil
	end
	table.clear(figures)
	table.clear(boards)
	ToolboxCues.stopLoop("spaceNeon")
end

local function updateFigure(f: Figure, now: number, camPos: Vector3, camLook: Vector3, target: Vector3, low: boolean)
	local to = f.pos - camPos
	local dist = to.Magnitude
	local interval = Rules.updateInterval(dist, low)
	local em = f.emitter
	if not interval or (dist > 400 and to:Dot(camLook) < -0.25 * dist) then
		if em and em.Rate ~= 0 then
			em.Rate = 0
		end
		return
	end
	if em then
		local want = if low or dist > 900 then 0 else f.baseRate * Settings.particleScale()
		if em.Rate ~= want then
			em.Rate = want
		end
	end
	if now < f.nextAt then
		return
	end
	f.nextAt = now + interval
	local want = Rules.lookYaw(f.faceYaw, f.pos, target)
	f.headYaw += (want - f.headYaw) * math.min(1, interval * 3) -- smooth follow
	local pose = Rules.pose(now, f.phase, f.height, f.lean, f.headYaw)
	local cfs = f.cfs
	local flick = Rules.flicker(now, f.phase)
	local jitter = if flick > 0.25 then Vector3.new(f.height * 0.01, 0, 0) else Vector3.zero -- glitch: a sideways tear
	for i = 1, #pose do
		cfs[i] = f.base * pose[i] + jitter
	end
	workspace:BulkMoveTo(f.parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	-- quantised so a part is only written when the shimmer moved a visible step
	local q = math.floor(flick * 20 + 0.5) / 20
	if q ~= f.lastTransparency then
		f.lastTransparency = q
		for i, p in f.parts do
			if not Rules.ACCENT_PARTS[p.Name] then
				p.Transparency = math.min(0.95, BODY_TRANSPARENCY + q)
			end
		end
	end
end

local function updateBoard(b: Board, now: number, camPos: Vector3)
	local dist = (b.pos - camPos).Magnitude
	if dist > 1800 or now < b.nextAt then
		return
	end
	b.nextAt = now + (if dist < 700 then 0.1 else 0.25)
	local s = Rules.board(now, b.index)
	local copy = Rules.COPY[s.copy]
	local text = Rules.typed(copy.title, s.reveal)
	if s.copy ~= b.lastCopy then
		b.lastCopy = s.copy
		b.sub.Text = copy.sub
	end
	if text ~= b.lastText then
		b.lastText = text
		b.title.Text = text
	end
	if s.glitch ~= b.lastGlitch then
		b.lastGlitch = s.glitch
		b.title.Position = if s.glitch then UDim2.fromScale(0.06, 0.12) else UDim2.fromScale(0.04, 0.12)
		b.title.TextTransparency = if s.glitch then 0.45 else 0
		-- audio-v2: a board tearing near the racer crackles (positional, once per tear, in earshot only).
		if s.glitch and dist < AudioRules.HOLO_RANGE then
			ToolboxCues.playAt("holo_glitch", b.pos)
		end
	end
	local c = Rules.cycle(now, 18, b.index / #Rules.SYNTH)
	b.stroke.Color = c
	b.sub.TextColor3 = c
	b.bar.Position = UDim2.fromScale(0, (now * 0.35 + b.index * 0.2) % 1)
end

local function build()
	local my = token
	local root = Instance.new("Folder")
	root.Name = FOLDER_NAME
	for i, d in Layout.holograms do
		local ok, err = pcall(function()
			table.insert(figures, buildFigure(root, i, d))
		end)
		if not ok then
			warn("[SkyRally][SPACE-NEON] figure " .. i .. ": " .. tostring(err))
		end
	end
	for i, d in Layout.billboards do
		local ok, err = pcall(function()
			table.insert(boards, buildBoard(root, i, d))
		end)
		if not ok then
			warn("[SkyRally][SPACE-NEON] billboard " .. i .. ": " .. tostring(err))
		end
	end
	if my ~= token then
		root:Destroy()
		return
	end
	root.Parent = workspace
	folder = root
	conn = RunService.Heartbeat:Connect(function()
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		local ok, err = pcall(function()
			local now = workspace:GetServerTimeNow()
			local camPos = cam.CFrame.Position
			local camLook = cam.CFrame.LookVector
			local target = Kit.focus()
			local lowNow = Settings.lowGraphics()
			for _, f in figures do
				updateFigure(f, now, camPos, camLook, target, lowNow)
			end
			-- audio-v2: ONE hum loop, moved onto the nearest figure while one is within earshot.
			local nearest, nearD = nil :: Figure?, AudioRules.HOLO_RANGE
			for _, f in figures do
				local d = (f.pos - camPos).Magnitude
				if d < nearD then
					nearest, nearD = f, d
				end
			end
			if nearest then
				if ToolboxCues.startLoop("spaceNeon", "holo_hum", nearest.pos) then
					ToolboxCues.setLoopPosition(nearest.pos)
				end
			else
				ToolboxCues.stopLoop("spaceNeon")
			end
			for _, b in boards do
				updateBoard(b, now, camPos)
			end
		end)
		if not ok then
			warn("[SkyRally][SPACE-NEON] " .. tostring(err))
		end
	end)
	print(string.format("[SkyRally][SPACE-NEON] %d holo figures, %d billboards", #figures, #boards))
end

local function refresh()
	stop()
	if RaceAttr.mine("ActiveTrackId") ~= Rules.TRACK_ID or workspace:GetAttribute("TrackSwitching") == true then
		return
	end
	if workspace:GetAttribute("SpaceNeonHide") == true then
		return
	end
	local my = token
	task.defer(function()
		if my == token then
			build()
		end
	end)
end

function SpaceNeon.init()
	RaceAttr.changed("ActiveTrackId", refresh)
	workspace:GetAttributeChangedSignal("TrackSwitching"):Connect(refresh)
	workspace:GetAttributeChangedSignal("SpaceNeonHide"):Connect(refresh)
	workspace:GetAttributeChangedSignal("SpaceNeonTest"):Connect(function()
		if workspace:GetAttribute("SpaceNeonTest") == true then
			workspace:SetAttribute("SpaceNeonTest", nil)
			print(string.format("[SkyRally][SPACE-NEON] test: %d figures, %d billboards, folder %s", #figures, #boards, tostring(folder)))
		end
	end)
	refresh()
end

return SpaceNeon
