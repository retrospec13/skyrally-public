--!strict
-- The world's sound around the player (docs/REMARKABLE.md Batch 2; decisions in shared/SoundscapeRules, pinned by
-- tools/tests/soundscape_spec.luau):
--   12. Zone ambience beds: one looped bed per zone (amb_<zone>), crossfaded on ActiveZone, eased down under the
--       track-switch curtain; the DINO bed swells as you drop toward the lava; a Storm Cup lays rain and distant thunder
--       over the zone bed. (SoundJuice's old engine-sample "lava rumble" is now DINO-only, and off once amb_dino exists.)
--   29. Rival engine voices and Doppler fly-bys: the three nearest other racers (bots, players; never your own vehicle
--       or a boss) each get one pooled 3D engine loop, a voice of their own (a bratty single, a lumpy V-twin, a turbo
--       six; planes a radial prop), pitched by their speed and bent by a cartoon Doppler as they come and go; a racer
--       that tears past within a few car lengths adds a whoosh. Plus two touches on the player's own vehicle: a speed
--       wind that rushes in at full tilt, and a lift-off backfire (pop-pop-crackle) when the revs fall from speed.
-- Budget (low-end phone): at most 3 extra 3D loops (RIVAL slots, pooled, never more), 2D beds created once per zone
-- and stopped when silent, the racer scan at 5 Hz, per-frame work only on the 3 slots (no allocation per frame), every
-- effect client-side and cosmetic (no speed, no physics). Ids come from shared/SoundscapeAudio (generated by
-- tools/vfx/upload_set.py); a missing id is silent with one log line, like Music.
-- Lifecycle: Soundscape.init() (idempotent; SoundJuice.init calls it), Soundscape.telemetry() each frame from
-- SoundJuice.step with the local vehicle's speed and altitude.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Prof = require(Shared:WaitForChild("Prof")) -- MicroProfiler labels (perf review v21 PF-10)
local Rules = require(Shared:WaitForChild("SoundscapeRules"))
local ToolboxAudioRules = require(Shared:WaitForChild("ToolboxAudioRules"))
local ToolboxCues = require(script.Parent:WaitForChild("ToolboxCues"))
-- Storm race v2: the storm layer follows the LOCAL player's race mode (workspace while PER_GROUP is off), so a racer in
-- a normal group race never hears the hub's storm while a storm field races elsewhere.
local RaceAttr = require(Shared:WaitForChild("RaceAttr"))
-- Audit H13: rival engines, backfire and fly-by whooshes are effects (EFFECTS slider); beds and wind stay ambience.
local Settings = require(script.Parent:WaitForChild("Settings"))

local LocalPlayer = Players.LocalPlayer

local Soundscape = {}

local BED_RATE = 1.4 -- 1/s: about a 2 s crossfade between beds
local WIND_RATE = 3
local SLOT_RATE = 6 -- a rival voice fades in over ~0.3 s
local RIVAL_VOLUME = 0.5
local WHOOSH_VOLUME = 0.75
local BACKFIRE_VOLUME = 0.55
local SCAN_EVERY = 0.2 -- 5 Hz racer scan
local CUT_DIST = 60 -- a position step this big in one frame is a camera cut or a respawn, not motion

local assets: { [string]: string } = {}
local logged: { [string]: boolean } = {}
local inited = false
local group: SoundGroup? = nil -- ambience beds and wind (the player's AmbienceVolume)

local function logMissing(cue: string)
	if not logged[cue] then
		logged[cue] = true
		print("[SkyRally][SOUNDSCAPE] no asset for " .. cue .. " (silent)")
	end
end

function Soundscape.has(cue: string): boolean
	return assets[cue] ~= nil
end

function Soundscape.asset(cue: string): string?
	return assets[cue]
end

local function newSound(cue: string, looped: boolean, parent: Instance, g: SoundGroup?): Sound?
	local id = assets[cue]
	if not id then
		logMissing(cue)
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = "SkyRally_" .. cue
	s.SoundId = id
	s.Looped = looped
	s.Volume = 0
	s.SoundGroup = g
	s.Parent = parent
	return s
end

local function userScale(): number
	local v = LocalPlayer:GetAttribute("AmbienceVolume")
	return if type(v) == "number" then math.clamp(v, 0, 1) else 1
end

------------------------------------------------------------------------------------------------------------------------
-- 12. Ambience beds

local beds: { [string]: Sound } = {} -- created on first use; silent ones stop, and go once their zone/mode is left
local bedTargets: { [string]: number } = {}
local activeBed: string? = nil
local stormOn = false
local curtain = false
local altitude = 1000
local zone: string? = nil

local function bed(cue: string): Sound?
	local s = beds[cue]
	if s and s.Parent then
		return s
	end
	local made = newSound(cue, true, SoundService, group)
	if made then
		beds[cue] = made
	end
	return made
end

local function refreshBeds()
	local z = RaceAttr.mine("ActiveZone")
	zone = if type(z) == "string" then z else nil
	activeBed = Rules.ambienceCue(zone)
	stormOn = Rules.stormLayer(RaceAttr.mine("RaceMode"), workspace:GetAttribute("StormRaceLive") == true or workspace:GetAttribute("HubStormQA") == true)
	curtain = workspace:GetAttribute("TrackSwitching") == true
	if activeBed then
		bed(activeBed)
	end
	if stormOn then
		bed("amb_storm")
	end
end

-- Storm Cup race (not the hub, whose HubStorm claps follow its bolts): a far clap every 14-30 s over the rain bed.
local nextClap = 0
local clapRng = Random.new()
local function stepThunder(now: number)
	if not stormOn or curtain or RaceAttr.mine("RaceMode") == "hub" then
		nextClap = 0
		return
	end
	if nextClap == 0 then
		nextClap = now + ToolboxAudioRules.thunderGap(clapRng:NextNumber())
	elseif now >= nextClap then
		nextClap = now + ToolboxAudioRules.thunderGap(clapRng:NextNumber())
		local cue, pitch = ToolboxAudioRules.thunder(clapRng:NextNumber(), clapRng:NextNumber())
		ToolboxCues.play(cue, pitch, 0.8)
	end
end

local function stepBeds(dt: number)
	stepThunder(os.clock())
	local scale = userScale() * (if curtain then Rules.CURTAIN_DUCK else 1)
	local dino = if zone == "DINO" then Rules.dinoBedGain(Rules.lavaProximity(altitude)) else 1
	for cue in beds do
		bedTargets[cue] = 0
	end
	if activeBed then
		bedTargets[activeBed] = Rules.ambienceVolume(zone) * dino * scale
	end
	if stormOn then
		bedTargets.amb_storm = Rules.STORM_VOLUME * scale
	end
	local k = math.min(1, dt * BED_RATE)
	for cue, s in beds do
		local target = bedTargets[cue] or 0
		if target > 0 and not s.IsPlaying then
			s.Volume = 0
			s:Play()
		end
		if s.IsPlaying then
			local v = s.Volume + (target - s.Volume) * k
			if target == 0 and v < 0.004 then
				s.Volume = 0
				s:Stop()
				-- A stopped Sound still holds its loaded audio (perf pass 2026-10-19: the Sounds memory tag grew with
				-- every zone visited). A bed this zone and mode no longer use goes; bed() makes it again on the next
				-- refresh that wants it. The active bed and the storm layer only pause (their gain can come back).
				if cue ~= activeBed and not (stormOn and cue == "amb_storm") then
					s:Destroy()
					beds[cue] = nil
					bedTargets[cue] = nil
				end
			else
				s.Volume = v
			end
		end
	end
end

------------------------------------------------------------------------------------------------------------------------
-- 29a. The player's own vehicle: speed wind and the lift-off backfire

local wind: Sound? = nil
local windTarget = 0
local backfire: Sound? = nil
local lastBackfire = -math.huge
local smoothSpeed: number? = nil
local smoothDecel = 0
local lastTelemetry = -math.huge -- no controller stepping (spectating, results): the wind dies down

local function vehicleKind(): string
	local v = RaceAttr.mine("ActiveVehicle")
	return if v == "car" then "car" else "plane"
end

-- From SoundJuice.step, every frame the local controller runs: speed (studs/s), altitude (studs; 1000 off DINO).
function Soundscape.telemetry(dt: number, speed: number, altitudeY: number, boostState: string)
	if not inited or dt <= 0 then
		return
	end
	altitude = altitudeY
	lastTelemetry = os.clock()
	windTarget = Rules.windGain(speed, vehicleKind())
	local prev = smoothSpeed or speed
	local k = math.min(1, dt * 12) -- ~80 ms smoothing: network and frame jitter are not a lift
	local sm = prev + (speed - prev) * k
	smoothSpeed = sm
	smoothDecel += ((prev - sm) / dt - smoothDecel) * k
	local now = os.clock()
	if curtain then
		return
	end
	if Rules.backfire(sm, smoothDecel, boostState, now - lastBackfire, math.random()) then
		lastBackfire = now
		local s = backfire
		if not s or not s.Parent then
			s = newSound("eng_backfire", false, SoundService, Settings.sfxGroup())
			backfire = s
		end
		if s then
			s.PlaybackSpeed = 0.9 + 0.25 * math.random()
			s.Volume = BACKFIRE_VOLUME
			s.TimePosition = 0
			s:Play()
		end
	end
end

local function stepWind(dt: number)
	if os.clock() - lastTelemetry > 0.3 then
		windTarget = 0
	end
	local s = wind
	if not s then
		if windTarget <= 0 then
			return
		end
		s = newSound("wind_rush", true, SoundService, group)
		if not s then
			windTarget = 0
			return
		end
		wind = s
	end
	local w = s :: Sound
	local target = if curtain then 0 else windTarget * userScale()
	local v = w.Volume + (target - w.Volume) * math.min(1, dt * WIND_RATE)
	if target <= 0 and v < 0.003 then
		if w.IsPlaying then
			w:Stop()
		end
		w.Volume = 0
		return
	end
	if not w.IsPlaying then
		w:Play()
	end
	w.Volume = v
	w.PlaybackSpeed = 0.85 + 0.5 * math.clamp(windTarget / 0.55, 0, 1)
end

------------------------------------------------------------------------------------------------------------------------
-- 29b. Rival engine voices, Doppler and fly-bys

type Slot = {
	attach: Attachment,
	engine: Sound?, -- the loop (created when the first voice id exists)
	whoosh: Sound?,
	cue: string, -- the voice cue the engine holds
	model: Model?,
	hull: BasePart?,
	pitch: number, -- the voice's base pitch
	vol: number,
	pos: Vector3,
	vel: Vector3,
	dist: number,
	radial: number,
	doppler: number,
	lastWhoosh: number,
	fresh: boolean, -- first frame on this racer: no velocity yet
}

local slots: { Slot } = {}
local scanClock = 0
local listenerPos: Vector3? = nil
local listenerVel = Vector3.zero
local dists: { [Model]: number } = {}
local held: { Model } = {}

local function newSlot(i: number): Slot
	local a = Instance.new("Attachment")
	a.Name = "SkyRallyRivalVoice" .. i
	a.Parent = workspace.Terrain
	return {
		attach = a,
		engine = nil,
		whoosh = nil,
		cue = "",
		model = nil,
		hull = nil,
		pitch = 1,
		vol = 0,
		pos = Vector3.zero,
		vel = Vector3.zero,
		dist = math.huge,
		radial = 0,
		doppler = 1,
		lastWhoosh = -math.huge,
		fresh = true,
	}
end

local function hullOf(m: Model): BasePart?
	local h = m.PrimaryPart or m:FindFirstChild("Hull")
	return if h and h:IsA("BasePart") then h else nil
end

-- Whose engine is this model: nil for the player's own vehicle, a boss, or a racer who is out of the battle.
local function voiceId(m: Model): number?
	if m:GetAttribute("IsBoss") == true or m:GetAttribute("BattleOut") == true then
		return nil
	end
	local uid = m:GetAttribute("OwnerUserId")
	if type(uid) == "number" then
		if uid == LocalPlayer.UserId then
			return nil
		end
		local owner = Players:GetPlayerByUserId(uid)
		if owner and owner:GetAttribute("BattleOut") == true then
			return nil
		end
		return uid
	end
	local bot = m:GetAttribute("BotId")
	if type(bot) == "number" then
		return bot
	end
	return nil
end

local function release(slot: Slot)
	slot.model = nil
	slot.hull = nil
end

-- The slot's pooled 3D loop (made once per slot, kept for the session).
local function engineSound(parent: Attachment): Sound
	local s = Instance.new("Sound")
	s.Name = "Engine"
	s.Looped = true
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 14
	s.RollOffMaxDistance = Rules.MAX_DIST
	Settings.sfx(s)
	s.Parent = parent
	return s
end

local function assign(slot: Slot, m: Model, hull: BasePart)
	local id = voiceId(m) or 0
	local kind = if m:GetAttribute("VehicleType") == "car" then "car" else "plane"
	local voice = Rules.voiceFor(id, kind)
	slot.model = m
	slot.hull = hull
	slot.pitch = voice.pitch
	slot.pos = hull.Position
	slot.vel = Vector3.zero
	slot.radial = 0
	slot.dist = math.huge -- the last racer's range would read as a closing speed (a false whoosh)
	slot.doppler = 1
	slot.fresh = true
	slot.vol = 0
	if slot.cue ~= voice.cue or not slot.engine then
		local id2 = assets[voice.cue]
		if not id2 then
			logMissing(voice.cue)
			release(slot)
			return
		end
		local snd = slot.engine or engineSound(slot.attach)
		slot.engine = snd
		snd.SoundId = id2
		slot.cue = voice.cue
		snd.Volume = 0
		snd.TimePosition = math.random() * 1.5 -- two rivals with one voice never start in phase
	end
	local e = slot.engine :: Sound
	e.Volume = 0
	if not e.IsPlaying then
		e:Play()
	end
end

local function scan()
	table.clear(dists)
	local lp = listenerPos
	local planes = workspace:FindFirstChild("Planes")
	if lp and planes and not curtain then
		for _, m in planes:GetChildren() do
			if m:IsA("Model") and voiceId(m) ~= nil then
				local h = hullOf(m)
				if h then
					dists[m] = (h.Position - lp).Magnitude
				end
			end
		end
	end
	table.clear(held)
	for _, slot in slots do
		if slot.model then
			table.insert(held, slot.model)
		end
	end
	local keep = Rules.pickVoices(dists, held)
	local wanted: { [Model]: boolean } = {}
	for _, m in keep do
		wanted[m] = true
	end
	-- Free slots whose racer lost its voice, then hand free slots to newcomers.
	for _, slot in slots do
		local m = slot.model
		if m and (not wanted[m] or not m.Parent) then
			release(slot)
		elseif m then
			wanted[m] = nil -- already voiced
		end
	end
	for m in wanted do
		-- A slot still fading out its last racer is taken only when no silent one is free (no voice is cut mid-word).
		local pick: Slot? = nil
		for _, slot in slots do
			if not slot.model and (pick == nil or slot.vol < (pick :: Slot).vol) then
				pick = slot
			end
		end
		local h = hullOf(m)
		if pick and h then
			assign(pick, m, h)
		end
	end
end

local function stepSlots(dt: number)
	local lp = listenerPos
	if not lp then
		return
	end
	local now = os.clock()
	local k = math.min(1, dt * 8)
	for _, slot in slots do
		local e = slot.engine
		if not e then
			continue
		end
		local hull = slot.hull
		if not slot.model or not hull or not hull.Parent then
			-- No racer: fade the loop out and stop it.
			slot.vol = math.max(0, slot.vol - dt * SLOT_RATE)
			e.Volume = slot.vol * RIVAL_VOLUME
			if slot.vol <= 0 and e.IsPlaying then
				e:Stop()
			end
			continue
		end
		local pos = hull.Position
		local step = pos - slot.pos
		if slot.fresh or step.Magnitude > CUT_DIST then
			slot.fresh = false
			slot.vel = Vector3.zero
		else
			slot.vel += (step / dt - slot.vel) * k
		end
		slot.pos = pos
		slot.attach.WorldPosition = pos
		local toL = lp - pos
		local dist = toL.Magnitude
		local closing = if slot.dist < math.huge then (slot.dist - dist) / dt else 0
		slot.dist = dist
		local prevRadial = slot.radial
		slot.radial += (closing - slot.radial) * k
		local rel = slot.vel - listenerVel
		if Rules.isFlyby(prevRadial, slot.radial, dist, rel.Magnitude) and now - slot.lastWhoosh > Rules.FLYBY_COOLDOWN then
			slot.lastWhoosh = now
			local w = slot.whoosh
			if not w then
				w = newSound("flyby_whoosh", false, slot.attach, Settings.sfxGroup())
				if w then
					w.RollOffMode = Enum.RollOffMode.InverseTapered
					w.RollOffMinDistance = 10
					w.RollOffMaxDistance = 120
				end
				slot.whoosh = w
			end
			if w then
				w.PlaybackSpeed = 0.85 + 0.35 * math.clamp(rel.Magnitude / 300, 0, 1)
				w.Volume = WHOOSH_VOLUME
				w.TimePosition = 0
				w:Play()
			end
		end
		local d = Rules.doppler(pos.X, pos.Y, pos.Z, slot.vel.X, slot.vel.Y, slot.vel.Z, lp.X, lp.Y, lp.Z, listenerVel.X, listenerVel.Y, listenerVel.Z)
		slot.doppler += (d - slot.doppler) * math.min(1, dt * 10)
		e.PlaybackSpeed = slot.pitch * Rules.speedPitch(slot.vel.Magnitude) * slot.doppler
		slot.vol = math.min(1, slot.vol + dt * SLOT_RATE)
		e.Volume = slot.vol * RIVAL_VOLUME
	end
end

local function stepListener(dt: number)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local p = cam.CFrame.Position
	local prev = listenerPos
	if prev and (p - prev).Magnitude <= CUT_DIST then
		listenerVel += ((p - prev) / dt - listenerVel) * math.min(1, dt * 8)
	else
		listenerVel = Vector3.zero -- a camera cut is not motion
	end
	listenerPos = p
end

------------------------------------------------------------------------------------------------------------------------

local function onStep(dt: number)
	if dt <= 0 then
		return
	end
	stepListener(dt)
	scanClock -= dt
	if scanClock <= 0 then
		scanClock = SCAN_EVERY
		scan()
	end
	stepSlots(dt)
	stepBeds(dt)
	stepWind(dt)
end

function Soundscape.init()
	if inited then
		return
	end
	inited = true
	local mod = Shared:FindFirstChild("SoundscapeAudio")
	local ok, t = pcall(function()
		return require(mod :: ModuleScript) :: any
	end)
	assets = if ok and type(t) == "table" then t else {}
	local g = Instance.new("SoundGroup")
	g.Name = "SkyRallyAmbience"
	g.Volume = 1
	g.Parent = SoundService
	group = g
	for i = 1, Rules.MAX_VOICES do
		slots[i] = newSlot(i)
	end
	for _, attr in { "TrackSwitching", "StormRaceLive", "HubStormQA" } do
		workspace:GetAttributeChangedSignal(attr):Connect(refreshBeds)
	end
	RaceAttr.changed("ActiveZone", refreshBeds)
	RaceAttr.changed("RaceMode", refreshBeds) -- exactly the workspace signal while PER_GROUP is off
	refreshBeds()
	RunService.Heartbeat:Connect(Prof.wrap("SR_Soundscape", onStep))
	local n = 0
	for _ in assets do
		n += 1
	end
	print(string.format("[SkyRally][SOUNDSCAPE] ready cues=%d voices=%d", n, Rules.MAX_VOICES))
end

return Soundscape
