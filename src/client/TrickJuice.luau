--!strict
-- Trick and start feedback for the trick lane (REMARKABLE Batch 1 items 5, 6, 7): pooled one-shot sounds and the
-- callout stamps (STUCK IT!, PERFECT START!, FLOODED!, THREADED!). Shared by CarController and FlightController.
--
-- Sounds: synthesised cues (tools/audio/synth_tricks.py) uploaded into shared/TrickAudio (generated by
-- tools/vfx/upload_set.py). A cue with no uploaded id is silent: nothing is created and one log line total is
-- printed, so the game runs the same before the upload. Each cue has a small round-robin pool (no per-trigger
-- Instance.new, no stacking past POOL voices); 3D variants for other players' cars reuse one Sound per car.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
-- Audit H13: trick cues go through the EFFECTS slider.
local Settings = require(script.Parent:WaitForChild("Settings"))
local HudMetrics = require(script.Parent:WaitForChild("HudMetrics"))
local HudLayoutRules = require(Shared:WaitForChild("HudLayoutRules"))

local TrickJuice = {}

local POOL = 2
local VOLUMES: { [string]: number } = {
	hop_boing = 0.55,
	trick_whoosh = 0.5,
	trick_stuck = 0.6,
	trick_flub = 0.6,
	start_perfect = 0.7,
	start_flood = 0.75,
	roll_whoosh_l = 0.55,
	roll_whoosh_r = 0.55,
}

local ids: { [string]: string } = {}
local loaded = false
local warned = false
local folder: Folder? = nil
local pools: { [string]: { list: { Sound }, nextIndex: number } } = {}

local function loadIds()
	if loaded then
		return
	end
	loaded = true
	-- The shared AudioAssets, then this lane's generated TrickAudio (which wins), so a cue can move between them.
	for _, name in { "AudioAssets", "TrickAudio" } do
		local mod = Shared:FindFirstChild(name)
		if mod and mod:IsA("ModuleScript") then
			local ok, t = pcall(require, mod)
			if ok and type(t) == "table" then
				for k, v in t :: { [string]: any } do
					if type(k) == "string" and type(v) == "string" then
						ids[k] = v
					end
				end
			end
		end
	end
end

local function idFor(cue: string): string?
	loadIds()
	local id = ids[cue]
	if not id then
		if not warned then
			warned = true
			print("[SkyRally][TRICK] trick sounds not uploaded yet (first missing: " .. cue .. "); tricks run silent")
		end
		return nil
	end
	return id
end

local function ensureFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = SoundService:FindFirstChild("SkyRallyTricks")
	if not f or not f:IsA("Folder") then
		local nf = Instance.new("Folder")
		nf.Name = "SkyRallyTricks"
		nf.Parent = SoundService
		f = nf
	end
	folder = f :: Folder
	return f :: Folder
end

-- Plays a 2D cue (the local player's own trick). pitch defaults to 1, with a small random spread so repeats do not
-- sound machine-gunned.
function TrickJuice.play(cue: string, pitch: number?, volume: number?)
	local id = idFor(cue)
	if not id then
		return
	end
	local p = pools[cue]
	if not p then
		local list: { Sound } = {}
		local parent = ensureFolder()
		for i = 1, POOL do
			local snd = Instance.new("Sound")
			snd.Name = cue .. "_" .. i
			snd.SoundId = id
			Settings.sfx(snd)
			snd.Parent = parent
			table.insert(list, snd)
		end
		p = { list = list, nextIndex = 1 }
		pools[cue] = p
	end
	local s = p.list[p.nextIndex]
	p.nextIndex = p.nextIndex % POOL + 1
	s.Volume = volume or VOLUMES[cue] or 0.6
	s.PlaybackSpeed = (pitch or 1) * (0.97 + math.random() * 0.06)
	s.TimePosition = 0
	s:Play()
end

-- Other players' grid bounces: one 3D Sound per car hull, created on first use and destroyed with the car.
function TrickJuice.play3D(cue: string, hull: BasePart, volume: number?)
	local id = idFor(cue)
	if not id then
		return
	end
	local name = "TrickSfx_" .. cue
	local s = hull:FindFirstChild(name)
	if not s or not s:IsA("Sound") then
		local ns = Instance.new("Sound")
		ns.Name = name
		ns.SoundId = id
		ns.RollOffMode = Enum.RollOffMode.InverseTapered
		ns.RollOffMinDistance = 12
		ns.RollOffMaxDistance = 140
		Settings.sfx(ns)
		ns.Parent = hull
		s = ns
	end
	local snd = s :: Sound
	snd.Volume = volume or (VOLUMES[cue] or 0.6) * 0.8
	snd.PlaybackSpeed = 0.94 + math.random() * 0.12
	snd.TimePosition = 0
	snd:Play()
end

-- ---------------------------------------------------------------- callouts
-- The HUD keeps one callout slot (REMARKABLE ground rules): the stamp reuses RaceUI's lane A hero banner through
-- RaceUI.stamp. RaceUI requires FlightController, so it is required lazily here (it is loaded by then).
local raceUI: any = nil
local function getRaceUI(): any
	if raceUI == nil then
		local mod = script.Parent:FindFirstChild("RaceUI")
		if mod and mod:IsA("ModuleScript") then
			local ok, m = pcall(require, mod)
			raceUI = if ok then m else false
		else
			raceUI = false
		end
	end
	return raceUI
end

TrickJuice.GOLD = Color3.fromRGB(255, 214, 90)
TrickJuice.BLUE = Color3.fromRGB(120, 210, 255)
TrickJuice.SOOT = Color3.fromRGB(190, 182, 176)
TrickJuice.MINT = Color3.fromRGB(140, 255, 170)

function TrickJuice.callout(text: string, color: Color3?, duration: number?)
	local ui = getRaceUI()
	if not ui then
		return
	end
	if type(ui.stamp) == "function" then
		ui.stamp(text, color, duration)
	elseif type(ui.showBanner) == "function" then
		ui.showBanner(text, color, duration)
	end
	print("[SkyRally][TRICK] " .. text)
end

-- ---------------------------------------------------------------- START ring (rev-match start)
-- Shown from TrickRules.TOUCH_TAP_SHOW_LEFT to GO above the right-hand buttons, and flashed green on the "1" (the
-- teaching cue). Cars and planes on Touch run auto-gas, so there it is the button: a tap inside the window is the
-- perfect start. With keys or a pad it is only the cue ("GAS ON 1"). Built once and reused; onTap is set by the
-- controller that is driving.
local ringGui: ScreenGui? = nil
local ringBtn: TextButton? = nil
local ringStroke: UIStroke? = nil
local ringScale: UIScale? = nil
local ringTap: (() -> ())? = nil

-- The GAS!/TAP! slot (HudLayoutRules rects.startRing): left of the touch zone, bottom-aligned, on touch; the
-- bottom-right corner above the respawn chip on desktop.
local function placeRing(b: GuiObject)
	local r = HudMetrics.rects().startRing
	b.Position = UDim2.fromOffset(r.x, r.y)
	b.Size = UDim2.fromOffset(r.w, r.h)
end

local function buildRing()
	if ringGui and ringGui.Parent then
		return
	end
	local pg = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return
	end
	local sg = Instance.new("ScreenGui")
	sg.Name = "SkyRallyStartRing"
	sg.IgnoreGuiInset = true
	sg.ScreenInsets = Enum.ScreenInsets.None -- placed from HudMetrics rects (insets already applied): a DeviceSafe gui would add the notch twice
	sg.ResetOnSpawn = false
	sg.DisplayOrder = 45
	sg.Enabled = false
	local b = Instance.new("TextButton")
	b.Name = "StartRing"
	-- The GAS!/TAP! slot: HudLayoutRules rects.startRing.
	b.AnchorPoint = Vector2.zero
	placeRing(b)
	-- UI v2: a round go-green key (gradient, ink outline, white display text); the outline pulses gold on the "1".
	b.BackgroundColor3 = Color3.fromRGB(90, 230, 115)
	b.BackgroundTransparency = 0
	b.AutoButtonColor = false
	b.Font = Enum.Font.GothamBlack
	b.FontFace = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)
	b.TextScaled = true
	b.TextColor3 = Color3.new(1, 1, 1)
	local face = Instance.new("UIGradient")
	face.Rotation = 90
	face.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(0.46, Color3.fromRGB(225, 240, 228)),
		ColorSequenceKeypoint.new(0.47, Color3.fromRGB(190, 215, 196)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 140, 95)),
	})
	face.Parent = b
	local textInk = Instance.new("UIStroke")
	textInk.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	textInk.Color = Color3.fromRGB(11, 21, 51)
	textInk.Thickness = 2.5
	textInk.Parent = b
	b.TextWrapped = true
	b.Selectable = false -- never steals gamepad selection on the grid
	b.Text = "ON 1"
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.18, 0)
	pad.PaddingRight = UDim.new(0.18, 0)
	pad.PaddingTop = UDim.new(0.26, 0)
	pad.PaddingBottom = UDim.new(0.26, 0)
	pad.Parent = b
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = b
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 4
	stroke.Color = Color3.fromRGB(11, 21, 51)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = b
	local sc = Instance.new("UIScale")
	sc.Parent = b
	b.Parent = sg
	b.Activated:Connect(function()
		if ringTap then
			ringTap()
		end
		sc.Scale = 0.85
		TweenService:Create(sc, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end)
	sg.Parent = pg
	ringGui, ringBtn, ringStroke, ringScale = sg, b, stroke, sc
end

local ringGreen = false
local ringTouch = false
-- Called every grid frame by the driving controller. show = inside the show window; green = inside the perfect
-- window; onTap = the touch handler (nil with keys or a pad: the ring is only the cue then).
function TrickJuice.setStartRing(show: boolean, green: boolean, onTap: (() -> ())?)
	if show then
		buildRing()
	end
	local sg = ringGui
	if not sg then
		return
	end
	if show and ringBtn then
		placeRing(ringBtn)
	end
	ringTap = onTap
	local touch = onTap ~= nil
	if sg.Enabled ~= show or (show and touch ~= ringTouch) then
		sg.Enabled = show
		ringGreen = false
		ringTouch = touch
		if ringStroke then
			ringStroke.Color = Color3.fromRGB(11, 21, 51)
		end
		if ringBtn then
			ringBtn.Text = if touch then "TAP ON 1" else "GAS ON 1"
			ringBtn.BackgroundColor3 = Color3.fromRGB(58, 98, 200)
			ringBtn.Active = touch
		end
	end
	if show and green ~= ringGreen then
		ringGreen = green
		if ringStroke then
			ringStroke.Color = if green then Color3.fromRGB(255, 216, 61) else Color3.fromRGB(11, 21, 51)
		end
		if ringBtn then
			ringBtn.Text = if green then (if ringTouch then "TAP!" else "GAS!") elseif ringTouch then "TAP ON 1" else "GAS ON 1"
			-- waiting: a navy key; the window: the go-green key with the gold rim
			ringBtn.BackgroundColor3 = if green then Color3.fromRGB(90, 230, 115) else Color3.fromRGB(58, 98, 200)
		end
		if green and ringScale then
			ringScale.Scale = HudLayoutRules.RING_PULSE -- the layout keeps this much room round the ring
			TweenService:Create(ringScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		end
	end
end

return TrickJuice
