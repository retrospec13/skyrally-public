--!strict
-- Style combo chain (REMARKABLE Batch 2 item 17). Every style move the player makes in a race feeds one chain:
-- tricks stuck (item 5), mini-turbos at each tier and the zone turbo (item 15), a perfect start (item 6), barrel rolls
-- and THREADED rings (item 7), near misses, squeezes and lava skims (item 16). Each counted move plays the next note
-- of a rising pentatonic scale, so a good run literally plays a tune; crossing a milestone flips the meter to the
-- zone's callout (NICE!, then ERUPTION! / ICE COLD! / AHOY! / GUST! / ORBITAL! / SHOWBOAT!, SUPER ..., MEGA ...,
-- ... LEGEND!) with a sting. A crash, spin-out, flub or respawn drops the chain with a comic "bwomp". The best chain
-- of the race is slapped onto the results card as a sticker.
--
-- One HUD slot: a small plank under the lap sign (top right, clear of the notice stack and the token plaque at every
-- RaceUI layout: 740x360, 844x390, desktop). Callouts stay inside it, so the shared banner slot is not used.
-- Off in battles (no events, no meter, no sticker). Rules and numbers: shared/StyleRules (Lune spec style_spec).
-- Cosmetic only: a chain grants nothing.
--
-- Sounds: synthesised cues (tools/audio/synth_style.py) in shared/StyleAudio (generated by tools/vfx/upload_set.py).
-- A cue without an id is silent (one log line in total), as TrickJuice does; small round-robin pools, no per-event
-- Instance.new. StyleChain.sfx returns false when the cue is missing so a caller can fall back to an older sound.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Prof = require(Shared:WaitForChild("Prof")) -- MicroProfiler labels (perf review v21 PF-10)
local RaceAttr = require(Shared:WaitForChild("RaceAttr"))
local StyleRules = require(Shared:WaitForChild("StyleRules"))
local HudMetrics = require(script.Parent:WaitForChild("HudMetrics"))
local HudPhase = require(script.Parent:WaitForChild("HudPhase"))
-- Audit H13: style cues go through the EFFECTS slider.
local Settings = require(script.Parent:WaitForChild("Settings"))

local LocalPlayer = Players.LocalPlayer

local StyleChain = {}

local chain = StyleRules.newChain()
local heldUntil = 0
local initialized = false

-- ================================================================ sounds
local POOL = 3
local VOLUMES: { [string]: number } = {
	style_tick = 0.42,
	style_zone = 0.62,
	style_break = 0.5,
	drift_tier1 = 0.5,
	drift_tier2 = 0.55,
	drift_tier3 = 0.7,
	near_miss = 0.55,
	lava_sizzle = 0.5,
	leash_warn = 0.5,
}
local ids: { [string]: string } = {}
local idsLoaded = false
local warned = false
local sndFolder: Folder? = nil
local pools: { [string]: { list: { Sound }, nextIndex: number } } = {}
local loops: { [string]: Sound } = {}

local function loadIds()
	if idsLoaded then
		return
	end
	idsLoaded = true
	-- The shared AudioAssets, then this lane's generated StyleAudio (which wins), so a cue can move between them.
	for _, name in { "AudioAssets", "StyleAudio" } do
		local mod = Shared:FindFirstChild(name)
		if mod and mod:IsA("ModuleScript") then
			local ok, t = pcall(require, mod)
			if ok and type(t) == "table" then
				for k, v in t :: { [string]: any } do
					if type(k) == "string" and type(v) == "string" then
						ids[k] = v
					end
				end
			end
		end
	end
end

local function idFor(cue: string): string?
	loadIds()
	local id = ids[cue]
	if not id and not warned then
		warned = true
		print("[SkyRally][STYLE] style sounds not uploaded yet (first missing: " .. cue .. "); style moves run silent")
	end
	return id
end

local function folder(): Folder
	if sndFolder and sndFolder.Parent then
		return sndFolder
	end
	local f = SoundService:FindFirstChild("SkyRallyStyle")
	if not f or not f:IsA("Folder") then
		local nf = Instance.new("Folder")
		nf.Name = "SkyRallyStyle"
		nf.Parent = SoundService
		f = nf
	end
	sndFolder = f :: Folder
	return f :: Folder
end

-- Plays a 2D one-shot. Returns false (and plays nothing) when the cue has no uploaded id.
function StyleChain.sfx(cue: string, pitch: number?, volume: number?): boolean
	local id = idFor(cue)
	if not id then
		return false
	end
	local p = pools[cue]
	if not p then
		local list: { Sound } = {}
		for i = 1, POOL do
			local s = Instance.new("Sound")
			s.Name = cue .. "_" .. i
			s.SoundId = id
			Settings.sfx(s)
			s.Parent = folder()
			table.insert(list, s)
		end
		p = { list = list, nextIndex = 1 }
		pools[cue] = p
	end
	local s = p.list[p.nextIndex]
	p.nextIndex = p.nextIndex % POOL + 1
	s.Volume = volume or VOLUMES[cue] or 0.5
	s.PlaybackSpeed = pitch or 1
	s.TimePosition = 0
	s:Play()
	return true
end

-- A looped bed (the lava sizzle): faded in while `on`, faded out and stopped otherwise. Call it on changes only. One
-- Sound per cue, created on first use.
local loopOn: { [string]: boolean } = {}
function StyleChain.loop(cue: string, on: boolean, volume: number?)
	if (loopOn[cue] == true) == on then
		return
	end
	loopOn[cue] = on
	local s = loops[cue]
	if not s then
		if not on then
			return
		end
		local id = idFor(cue)
		if not id then
			return
		end
		local ns = Instance.new("Sound")
		ns.Name = cue .. "_loop"
		ns.SoundId = id
		ns.Looped = true
		ns.Volume = 0
		Settings.sfx(ns)
		ns.Parent = folder()
		loops[cue] = ns
		s = ns
	end
	local snd = s :: Sound
	if on then
		if not snd.IsPlaying then
			snd.TimePosition = math.random() * math.max(0, snd.TimeLength - 0.1)
			snd:Play()
		end
		TweenService:Create(snd, TweenInfo.new(0.12), { Volume = volume or VOLUMES[cue] or 0.5 }):Play()
	else
		local tw = TweenService:Create(snd, TweenInfo.new(0.35), { Volume = 0 })
		tw.Completed:Connect(function()
			if not loopOn[cue] then
				snd:Stop()
			end
		end)
		tw:Play()
	end
end

-- ================================================================ HUD meter (one slot)
local gui: ScreenGui? = nil
local meter: Frame? = nil
local countLbl: TextLabel? = nil
local headLbl: TextLabel? = nil
local moveLbl: TextLabel? = nil
local fuseFill: Frame? = nil
local stroke: UIStroke? = nil
local meterScale: UIScale? = nil
local shownFuse = -1
local calloutUntil = 0
local hideAt = 0 -- os.clock() when a banked/broken meter finishes its exit
local meterState = "hidden" -- "hidden" | "live" | "exit"

local WOOD = Color3.fromRGB(58, 38, 24)
local CREAM = Color3.fromRGB(250, 242, 222)
local INK = Color3.fromRGB(36, 20, 10)
local RIM = Color3.fromRGB(224, 172, 76)

local function zone(): string?
	local z = RaceAttr.mine("ActiveZone")
	return if type(z) == "string" then z else nil
end

local function zoneColor3(): Color3
	local c = StyleRules.color(zone())
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function inBattle(): boolean
	return RaceAttr.mine("RaceMode") == "battle"
end

local function label(parent: Instance, name: string, font: Enum.Font, align: Enum.TextXAlignment): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Font = font
	l.TextColor3 = CREAM
	l.TextXAlignment = align
	l.TextScaled = true
	l.Text = ""
	local st = Instance.new("UIStroke")
	st.Color = INK
	st.Thickness = 1.6
	st.Parent = l
	l.Parent = parent
	return l
end

-- HUD layout v2: the combo panel sits right-aligned under the lap/time chip (HudLayoutRules rects.combo).
local function layout()
	local m = meter
	if not m then
		return
	end
	local r = HudMetrics.rects().combo
	m.Size = UDim2.fromOffset(r.w, r.h)
	m.Position = UDim2.fromOffset(r.x + r.w, r.y)
end

local function build()
	if gui and gui.Parent then
		return
	end
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return
	end
	local sg = Instance.new("ScreenGui")
	sg.Name = "SkyRallyStyleChain"
	sg.IgnoreGuiInset = true
	sg.ScreenInsets = Enum.ScreenInsets.None -- placed from HudMetrics rects (insets already applied): a DeviceSafe gui would add the notch twice
	sg.ResetOnSpawn = false
	sg.DisplayOrder = 6
	local f = Instance.new("Frame")
	f.Name = "StyleChainMeter"
	f.AnchorPoint = Vector2.new(1, 0)
	f.BackgroundColor3 = WOOD
	f.BackgroundTransparency = 0.12
	f.Visible = false
	f.Active = false
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 9)
	corner.Parent = f
	local st = Instance.new("UIStroke")
	st.Thickness = 2.5
	st.Color = RIM
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = f
	local sc = Instance.new("UIScale")
	sc.Parent = f
	-- Left: the big multiplier. Right: "STYLE" (or the milestone callout) over the last move. Bottom: the fuse.
	local c = label(f, "Count", Enum.Font.GothamBlack, Enum.TextXAlignment.Center)
	c.Position = UDim2.fromScale(0.02, 0.06)
	c.Size = UDim2.fromScale(0.38, 0.74)
	local hd = label(f, "Head", Enum.Font.GothamBlack, Enum.TextXAlignment.Left)
	hd.Position = UDim2.fromScale(0.42, 0.08)
	hd.Size = UDim2.fromScale(0.55, 0.4)
	local mv = label(f, "Move", Enum.Font.GothamBold, Enum.TextXAlignment.Left)
	mv.Position = UDim2.fromScale(0.42, 0.5)
	mv.Size = UDim2.fromScale(0.55, 0.3)
	mv.TextColor3 = Color3.fromRGB(236, 214, 170)
	local track = Instance.new("Frame")
	track.Name = "Fuse"
	track.AnchorPoint = Vector2.new(0.5, 1)
	track.Position = UDim2.new(0.5, 0, 1, -4)
	track.Size = UDim2.new(1, -14, 0, 4)
	track.BackgroundColor3 = Color3.fromRGB(30, 20, 12)
	track.BorderSizePixel = 0
	track.Parent = f
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = RIM
	fill.BorderSizePixel = 0
	fill.Parent = track
	f.Parent = sg
	sg.Parent = pg
	gui, meter, countLbl, headLbl, moveLbl, fuseFill, stroke, meterScale = sg, f, c, hd, mv, fill, st, sc
	layout()
	HudMetrics.onChanged(layout)
end

local function pop(scale: number, rot: number)
	local m, sc = meter, meterScale
	if not m or not sc then
		return
	end
	sc.Scale = scale
	TweenService:Create(sc, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	m.Rotation = rot
	TweenService:Create(m, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
end

local function showLive()
	build()
	local m = meter
	if not m then
		return
	end
	if meterState ~= "live" then
		meterState = "live"
		-- HudPhase hides it on the podium / results card and in the hub; its PhaseHudOn attribute is only set once HudPhase has found the
		-- freshly built meter (up to a second), so the phase table is asked directly too (a hub near-miss showed "x2 STYLE" for that second).
		m.Visible = m:GetAttribute("PhaseHudOn") ~= false and HudPhase.allows("StyleChainMeter")
		m.BackgroundColor3 = WOOD
		if stroke then
			stroke.Color = RIM
		end
		if headLbl then
			headLbl.TextColor3 = CREAM
		end
	end
end

local function refreshText(lastKind: string)
	if countLbl then
		countLbl.Text = "x" .. chain.count
	end
	if headLbl and os.clock() >= calloutUntil then
		headLbl.Text = "STYLE"
		headLbl.TextColor3 = CREAM
	end
	if moveLbl then
		moveLbl.Text = StyleRules.LABELS[lastKind] or ""
	end
end

local function exitMeter(text: string, color: Color3, seconds: number)
	local m = meter
	if not m or meterState == "hidden" then
		return
	end
	meterState = "exit"
	hideAt = os.clock() + seconds
	calloutUntil = 0
	if headLbl then
		headLbl.Text = text
		headLbl.TextColor3 = color
	end
	if fuseFill then
		fuseFill.Size = UDim2.fromScale(0, 1)
		shownFuse = 0
	end
end

-- ================================================================ chain
-- Whether moves count right now: a race in progress (after GO, before this player finishes), never in a battle or
-- under the map-switch curtain. The hub (free driving and flying) counts too, with no results card.
local function counting(): boolean
	if inBattle() or workspace:GetAttribute("TrackSwitching") == true or LocalPlayer:GetAttribute("RaceFinished") == true then
		return false
	end
	if LocalPlayer:GetAttribute("BattleOut") == true then
		return false
	end
	local go = RaceAttr.mine("RaceGoTime")
	if type(go) == "number" and workspace:GetServerTimeNow() < go then
		return false
	end
	return true
end

local function publish()
	LocalPlayer:SetAttribute("StyleChain", chain.count)
	LocalPlayer:SetAttribute("StyleBestChain", chain.best)
	LocalPlayer:SetAttribute("StyleBestText", chain.bestText)
end

-- A style move. kind: a StyleRules.POINTS key. Returns the points it added (0 = ignored or stale).
function StyleChain.event(kind: string): number
	StyleChain.init()
	if not counting() then
		return 0
	end
	local z = zone()
	local pts, tier = StyleRules.add(chain, kind, z)
	LocalPlayer:SetAttribute("StyleLastMove", kind)
	if pts <= 0 then
		return 0
	end
	publish()
	-- The next note of the scale (the base sample is a C5 marimba pluck).
	StyleChain.sfx("style_tick", StyleRules.tickPitch(chain.moves))
	if chain.count >= StyleRules.MIN_SHOW then
		showLive()
		refreshText(kind)
		pop(1.18 + math.min(0.2, pts * 0.06), if chain.moves % 2 == 0 then 4 else -4)
	end
	if tier > 0 then
		local text = StyleRules.milestoneText(tier, z)
		local col = if tier >= 2 then zoneColor3() else Color3.fromRGB(255, 226, 95)
		calloutUntil = os.clock() + 1.4
		if headLbl then
			headLbl.Text = text
			headLbl.TextColor3 = col
		end
		if stroke then
			stroke.Color = col
		end
		pop(1.5, -9)
		StyleChain.sfx("style_zone", 1 + 0.06 * (tier - 1))
		print(string.format("[SkyRally][STYLE] milestone %s chain=%d zone=%s", text, chain.count, tostring(z)))
	end
	return pts
end

-- A sustained move is running this frame (a drift charging, a lava skim): the fuse holds.
function StyleChain.sustain()
	heldUntil = os.clock() + 0.12
end

-- A crash, spin-out, flubbed trick or respawn. reason is for the log only.
function StyleChain.breakChain(reason: string)
	if chain.count <= 0 then
		return
	end
	local lost = StyleRules.breakChain(chain)
	publish()
	if lost >= StyleRules.MIN_SHOW then
		StyleChain.sfx("style_break")
		exitMeter("CHAIN LOST", Color3.fromRGB(255, 120, 96), 0.9)
		local m = meter
		if m then
			m.Rotation = 10
			TweenService:Create(m, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
		end
		print(string.format("[SkyRally][STYLE] chain lost x%d (%s)", lost, reason))
	end
end

function StyleChain.current(): number
	return chain.count
end

function StyleChain.best(): (number, string)
	return chain.best, chain.bestText
end

local function step(dt: number)
	if chain.count > 0 and (inBattle() or workspace:GetAttribute("TrackSwitching") == true) then
		StyleRules.breakChain(chain)
		publish()
	end
	local banked = StyleRules.tick(chain, dt, os.clock() < heldUntil)
	if banked > 0 then
		publish()
		if banked >= StyleRules.MIN_SHOW then
			exitMeter("BANKED x" .. banked, Color3.fromRGB(255, 226, 95), 0.8)
			pop(1.12, 0)
		end
	end
	local m = meter
	if not m then
		return
	end
	if meterState == "live" then
		local frac = math.clamp(chain.timer / StyleRules.window(chain.count), 0, 1)
		-- Edge writes only: the fuse moves in 2 % steps.
		local q = math.floor(frac * 50 + 0.5) / 50
		if q ~= shownFuse and fuseFill then
			shownFuse = q
			fuseFill.Size = UDim2.fromScale(q, 1)
			fuseFill.BackgroundColor3 = if q < 0.3 then Color3.fromRGB(255, 120, 96) else RIM
		end
		if headLbl and calloutUntil > 0 and os.clock() >= calloutUntil then
			calloutUntil = 0
			headLbl.Text = "STYLE"
			headLbl.TextColor3 = CREAM
			if stroke then
				stroke.Color = RIM
			end
		end
	elseif meterState == "exit" and os.clock() >= hideAt then
		meterState = "hidden"
		m.Visible = false
		shownFuse = -1
	end
end

local function resetRace()
	StyleRules.resetRace(chain)
	publish()
	if meter then
		meter.Visible = false
	end
	meterState = "hidden"
	shownFuse = -1
end

-- ================================================================ results sticker
local sticker: Frame? = nil

-- RaceUI.populateFinishModal hook: the race's best chain as a tilted sticker on the card's top-right corner. Hidden
-- in battles and below the first milestone.
function StyleChain.decorateResults(modal: GuiObject)
	StyleChain.init()
	local best, text = chain.best, chain.bestText
	local show = not inBattle() and best >= StyleRules.MILESTONES[1].at
	local s = sticker
	if not show then
		if s then
			s.Visible = false
		end
		return
	end
	if not s or s.Parent ~= modal then
		if s then
			s:Destroy()
		end
		local f = Instance.new("Frame")
		f.Name = "StyleBestSticker"
		-- Overhangs the card's top-right corner, clear of a centred "1ST PLACE!" title and of the lap sign at 740x360.
		f.AnchorPoint = Vector2.new(1, 0.5)
		f.Position = UDim2.new(1, 22, 0, -6)
		f.Size = UDim2.fromOffset(100, 36)
		f.BackgroundColor3 = Color3.fromRGB(26, 45, 107) -- UI v2 navy sticker (the rim takes the tier colour)
		f.ZIndex = 6
		local cr = Instance.new("UICorner")
		cr.CornerRadius = UDim.new(0, 8)
		cr.Parent = f
		local st = Instance.new("UIStroke")
		st.Name = "Rim"
		st.Thickness = 2.5
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		st.Parent = f
		local top = label(f, "Best", Enum.Font.GothamBlack, Enum.TextXAlignment.Center)
		top.Position = UDim2.fromScale(0.05, 0.06)
		top.Size = UDim2.fromScale(0.9, 0.5)
		top.ZIndex = 7
		local sub = label(f, "Callout", Enum.Font.GothamBold, Enum.TextXAlignment.Center)
		sub.Position = UDim2.fromScale(0.05, 0.56)
		sub.Size = UDim2.fromScale(0.9, 0.36)
		sub.ZIndex = 7
		local sc = Instance.new("UIScale")
		sc.Parent = f
		f.Parent = modal
		sticker = f
		s = f
	end
	local f = s :: Frame
	local col = if StyleRules.tierAt(best) >= 2 then zoneColor3() else Color3.fromRGB(255, 226, 95)
	local rim = f:FindFirstChild("Rim") :: UIStroke?
	if rim then
		rim.Color = col
	end
	local top = f:FindFirstChild("Best") :: TextLabel?
	if top then
		top.Text = "BEST STYLE x" .. best
	end
	local sub = f:FindFirstChild("Callout") :: TextLabel?
	if sub then
		sub.Text = if text ~= "" then text else "NICE!"
		sub.TextColor3 = col
	end
	f.Visible = true
	-- Slapped on: big and flat, then down at a tilt.
	local sc = f:FindFirstChildOfClass("UIScale")
	f.Rotation = -4
	TweenService:Create(f, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 9 }):Play()
	if sc then
		sc.Scale = 1.8
		TweenService:Create(sc, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
	task.delay(0.25, function()
		StyleChain.sfx("style_zone", 1.12, 0.45)
	end)
end

-- ================================================================ init
function StyleChain.init()
	if initialized then
		return
	end
	initialized = true
	publish()
	-- A new race (each server reset, RaceResetSeq) and a map switch start a fresh chain and race best.
	RaceAttr.changed("RaceResetSeq", resetRace)
	RaceAttr.changed("ActiveTrackId", resetRace)
	RunService.RenderStepped:Connect(Prof.wrap("SR_StyleChain", step))
end

return StyleChain
