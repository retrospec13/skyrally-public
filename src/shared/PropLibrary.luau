--!strict
-- Original set-dressing props (Higgsfield concept -> Tripo image-to-model -> Blender QC -> Open Cloud upload).
-- Files and provenance: assets/models/props/<zone>/<name>/ and docs/ASSETS.md. Keys are "<zone>_<name>", sorted,
-- one block per zone (zone agents edit only their own block). Units: studs, 1 GLB unit = 1 stud, pivot at the
-- base centre; size is the QC'd bounding box in Roblox axes (X, Y up, Z).
-- model = nil means the GLB is not uploaded yet (the art pass must skip it); collide = true for solid props the car
-- can hit, false for decorative ones.

export type Prop = {
	zone: string,
	name: string,
	model: number?,
	size: Vector3,
	tris: number,
	tags: { string },
	collide: boolean,
	glb: string?,
	status: string?,
}

